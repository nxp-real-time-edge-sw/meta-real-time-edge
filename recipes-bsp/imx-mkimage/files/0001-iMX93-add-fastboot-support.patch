+/**
+ * Read and validate boot entries from binary file
+ * @param filename: Path to the boot entries file
+ * @return: 0 on success, -1 on error
+ */
+int multicore_fastboot_read_file(const char *filename)
+{
+	FILE *fp;
+	fastboot_entries_header_t header;
+	struct stat st;
+	uint32_t calculated_checksum;
+	size_t entries_data_size;
+	fastboot_boot_entry_t *entries_le = NULL;
+	int ret = 0;
+
+	/* Check if file exists */
+	if (stat(filename, &st) != 0) {
+		fprintf(stderr, "Error: File %s does not exist\n", filename);
+		return -1;
+	}
+
+	/* Open file for binary reading */
+	fp = fopen(filename, "rb");
+	if (fp == NULL) {
+		fprintf(stderr, "Error: Failed to open %s\n", filename);
+		return -1;
+	}
+
+	/* Read header */
+	if (fread(&header, sizeof(header), 1, fp) != 1) {
+		fprintf(stderr, "Error: Failed to read header from %s\n", filename);
+		ret = -1;
+		goto cleanup;
+	}
+
+	/* Convert header fields from little-endian */
+	header.magic = le32_to_cpu(header.magic);
+	header.version = le16_to_cpu(header.version);
+	header.entry_count = le16_to_cpu(header.entry_count);
+	header.header_size = le32_to_cpu(header.header_size);
+	header.entry_size = le32_to_cpu(header.entry_size);
+	header.total_size = le32_to_cpu(header.total_size);
+	header.checksum = le32_to_cpu(header.checksum);
+
+	/* Validate magic number */
+	if (header.magic != FASTBOOT_ENTRIES_MAGIC) {
+		fprintf(stderr, "Error: Invalid magic number in %s (0x%08X, expected 0x%08X)\n",
+			filename, header.magic, FASTBOOT_ENTRIES_MAGIC);
+		fprintf(stderr, "       This is not a valid Cortex-A Core boot entries file\n");
+		ret = -1;
+		goto cleanup;
+	}
+
+	/* Validate version */
+	if (header.version != FASTBOOT_ENTRIES_VERSION) {
+		fprintf(stderr, "Warning: File version mismatch (0x%04X, expected 0x%04X)\n",
+			header.version, FASTBOOT_ENTRIES_VERSION);
+	}
+
+	/* Validate header size */
+	if (header.header_size != sizeof(fastboot_entries_header_t)) {
+		fprintf(stderr, "Error: Header size mismatch (%u, expected %zu)\n",
+			header.header_size, sizeof(fastboot_entries_header_t));
+		ret = -1;
+		goto cleanup;
+	}
+
+	/* Validate entry size */
+	if (header.entry_size != sizeof(fastboot_boot_entry_t)) {
+		fprintf(stderr, "Error: Entry size mismatch (%u, expected %zu)\n",
+			header.entry_size, sizeof(fastboot_boot_entry_t));
+		ret = -1;
+		goto cleanup;
+	}
+
+	/* Validate file size */
+	if ((size_t)st.st_size != header.total_size) {
+		fprintf(stderr, "Error: File size mismatch (%ld bytes, expected %u bytes)\n",
+			(long)st.st_size, header.total_size);
+		fprintf(stderr, "       File may be corrupted or incomplete\n");
+		ret = -1;
+		goto cleanup;
+	}
+
+	/* Validate entry count */
+	if (header.entry_count > MAX_FASTBOOT_ENTRIES) {
+		fprintf(stderr, "Error: Too many entries (%u, maximum %d)\n",
+			header.entry_count, MAX_FASTBOOT_ENTRIES);
+		ret = -1;
+		goto cleanup;
+	}
+
+	/* Read entries */
+	entries_data_size = header.entry_count * sizeof(fastboot_boot_entry_t);
+	if (header.entry_count > 0) {
+		entries_le = malloc(entries_data_size);
+		if (entries_le == NULL) {
+			fprintf(stderr, "Error: Memory allocation failed\n");
+			ret = -1;
+			goto cleanup;
+		}
+
+		if (fread(entries_le, entries_data_size, 1, fp) != 1) {
+			fprintf(stderr, "Error: Failed to read entries from %s\n", filename);
+			ret = -1;
+			goto cleanup;
+		}
+
+		/* Calculate and verify checksum before conversion */
+		calculated_checksum = calculate_crc32(entries_le, entries_data_size);
+
+		if (calculated_checksum != header.checksum) {
+			fprintf(stderr, "Error: Checksum mismatch (0x%08X, expected 0x%08X)\n",
+				calculated_checksum, header.checksum);
+			fprintf(stderr, "       File may be corrupted\n");
+			ret = -1;
+			goto cleanup;
+		}
+
+		/* Convert entries from little-endian */
+		for (int i = 0; i < header.entry_count; i++) {
+			fastboot_entries[i].core_id = le32_to_cpu(entries_le[i].core_id);
+			fastboot_entries[i].entry_addr = le64_to_cpu(entries_le[i].entry_addr);
+			fastboot_entries[i].flags = le32_to_cpu(entries_le[i].flags);
+			fastboot_entries[i].reserved = le32_to_cpu(entries_le[i].reserved);
+		}
+	}
+
+	fastboot_entry_count = header.entry_count;
+
+	fprintf(stdout, "\n");
+	fprintf(stdout, "========================================\n");
+	fprintf(stdout, "Successfully validated: %s\n", filename);
+	fprintf(stdout, "========================================\n");
+	fprintf(stdout, "Magic: 0x%08X (valid)\n", header.magic);
+	fprintf(stdout, "Version: 0x%04X\n", header.version);
+	fprintf(stdout, "Entry count: %d\n", header.entry_count);
+	fprintf(stdout, "Checksum: 0x%08X (valid)\n", header.checksum);
+	fprintf(stdout, "File size: %u bytes (valid)\n", header.total_size);
+	fprintf(stdout, "----------------------------------------\n");
+	fprintf(stdout, "Boot Entries:\n");
+	for (int i = 0; i < fastboot_entry_count; i++) {
+		fprintf(stdout, "  Core %u: 0x%016" PRIX64 "\n",
+			fastboot_entries[i].core_id, fastboot_entries[i].entry_addr);
+	}
+	fprintf(stdout, "========================================\n");
+	fprintf(stdout, "\n");
+
+cleanup:
+	if (entries_le)
+		free(entries_le);
+	fclose(fp);
+	return ret;
+}
+
+/**
+ * Dump and display fastboot entries from file or embedded location
+ * @param filename: Path to the file containing fastboot entries
+ * @param offset: Offset in file where entries are located (0 for standalone file)
+ * @return: 0 on success, -1 on error
+ */
+int multicore_fastboot_dump_file(const char *filename, uint64_t offset)
+{
+	FILE *fp;
+	fastboot_entries_header_t header;
+	struct stat st;
+	uint32_t calculated_checksum;
+	size_t entries_data_size;
+	fastboot_boot_entry_t *entries_le = NULL;
+	fastboot_boot_entry_t *entries = NULL;
+	int ret = 0;
+
+	/* Check if file exists */
+	if (stat(filename, &st) != 0) {
+		fprintf(stderr, "Error: File %s does not exist\n", filename);
+		return -1;
+	}
+
+	/* Check if offset is valid */
+	if (offset >= (uint64_t)st.st_size) {
+		fprintf(stderr, "Error: Offset 0x%llX exceeds file size %ld\n",
+			(unsigned long long)offset, (long)st.st_size);
+		return -1;
+	}
+
+	/* Open file for binary reading */
+	fp = fopen(filename, "rb");
+	if (fp == NULL) {
+		fprintf(stderr, "Error: Failed to open %s\n", filename);
+		return -1;
+	}
+
+	/* Seek to offset if specified */
+	if (offset > 0) {
+		if (fseek(fp, offset, SEEK_SET) != 0) {
+			fprintf(stderr, "Error: Failed to seek to offset 0x%llX\n",
+				(unsigned long long)offset);
+			fclose(fp);
+			return -1;
+		}
+	}
+
+	/* Read header */
+	if (fread(&header, sizeof(header), 1, fp) != 1) {
+		fprintf(stderr, "Error: Failed to read header from %s at offset 0x%llX\n",
+			filename, (unsigned long long)offset);
+		ret = -1;
+		goto cleanup;
+	}
+
+	/* Convert header fields from little-endian */
+	header.magic = le32_to_cpu(header.magic);
+	header.version = le16_to_cpu(header.version);
+	header.entry_count = le16_to_cpu(header.entry_count);
+	header.header_size = le32_to_cpu(header.header_size);
+	header.entry_size = le32_to_cpu(header.entry_size);
+	header.total_size = le32_to_cpu(header.total_size);
+	header.checksum = le32_to_cpu(header.checksum);
+
+	/* Print file information */
+	fprintf(stdout, "\n");
+	fprintf(stdout, "========================================\n");
+	fprintf(stdout, "Fastboot Entry File Dump\n");
+	fprintf(stdout, "========================================\n");
+	fprintf(stdout, "File: %s\n", filename);
+	if (offset > 0) {
+		fprintf(stdout, "Offset: 0x%llX (%llu bytes)\n",
+			(unsigned long long)offset, (unsigned long long)offset);
+	}
+	fprintf(stdout, "File size: %ld bytes\n", (long)st.st_size);
+	fprintf(stdout, "========================================\n");
+	fprintf(stdout, "\n");
+
+	/* Print header information */
+	fprintf(stdout, "Header Information:\n");
+	fprintf(stdout, "----------------------------------------\n");
+	fprintf(stdout, "Magic:           0x%08X", header.magic);
+	if (header.magic == FASTBOOT_ENTRIES_MAGIC) {
+		fprintf(stdout, " ('ACOR') [VALID]\n");
+	} else {
+		fprintf(stdout, " [INVALID - Expected 0x%08X]\n", FASTBOOT_ENTRIES_MAGIC);
+		fprintf(stderr, "\nError: Invalid magic number - not a fastboot entry file\n");
+		ret = -1;
+		goto cleanup;
+	}
+
+	fprintf(stdout, "Version:         0x%04X", header.version);
+	if (header.version == FASTBOOT_ENTRIES_VERSION) {
+		fprintf(stdout, " [VALID]\n");
+	} else {
+		fprintf(stdout, " [WARNING - Expected 0x%04X]\n", FASTBOOT_ENTRIES_VERSION);
+	}
+
+	fprintf(stdout, "Entry count:     %u\n", header.entry_count);
+	fprintf(stdout, "Header size:     %u bytes", header.header_size);
+	if (header.header_size == sizeof(fastboot_entries_header_t)) {
+		fprintf(stdout, " [VALID]\n");
+	} else {
+		fprintf(stdout, " [INVALID - Expected %zu]\n", sizeof(fastboot_entries_header_t));
+	}
+
+	fprintf(stdout, "Entry size:      %u bytes", header.entry_size);
+	if (header.entry_size == sizeof(fastboot_boot_entry_t)) {
+		fprintf(stdout, " [VALID]\n");
+	} else {
+		fprintf(stdout, " [INVALID - Expected %zu]\n", sizeof(fastboot_boot_entry_t));
+	}
+
+	fprintf(stdout, "Total size:      %u bytes\n", header.total_size);
+	fprintf(stdout, "Checksum:        0x%08X\n", header.checksum);
+	fprintf(stdout, "Reserved[0]:     0x%08X\n", le32_to_cpu(header.reserved[0]));
+	fprintf(stdout, "Reserved[1]:     0x%08X\n", le32_to_cpu(header.reserved[1]));
+	fprintf(stdout, "Reserved[2]:     0x%08X\n", le32_to_cpu(header.reserved[2]));
+	fprintf(stdout, "Reserved[3]:     0x%08X\n", le32_to_cpu(header.reserved[3]));
+	fprintf(stdout, "\n");
+
+	/* Validate entry count */
+	if (header.entry_count > MAX_FASTBOOT_ENTRIES) {
+		fprintf(stderr, "Error: Too many entries (%u, maximum %d)\n",
+			header.entry_count, MAX_FASTBOOT_ENTRIES);
+		ret = -1;
+		goto cleanup;
+	}
+
+	/* Read entries */
+	entries_data_size = header.entry_count * sizeof(fastboot_boot_entry_t);
+	if (header.entry_count > 0) {
+		entries_le = malloc(entries_data_size);
+		entries = malloc(entries_data_size);
+		if (entries_le == NULL || entries == NULL) {
+			fprintf(stderr, "Error: Memory allocation failed\n");
+			ret = -1;
+			goto cleanup;
+		}
+
+		if (fread(entries_le, entries_data_size, 1, fp) != 1) {
+			fprintf(stderr, "Error: Failed to read entries from %s\n", filename);
+			ret = -1;
+			goto cleanup;
+		}
+
+		/* Calculate and verify checksum before conversion */
+		calculated_checksum = calculate_crc32(entries_le, entries_data_size);
+
+		fprintf(stdout, "Checksum Verification:\n");
+		fprintf(stdout, "----------------------------------------\n");
+		fprintf(stdout, "Stored checksum:     0x%08X\n", header.checksum);
+		fprintf(stdout, "Calculated checksum: 0x%08X\n", calculated_checksum);
+		if (calculated_checksum == header.checksum) {
+			fprintf(stdout, "Status:              VALID\n");
+		} else {
+			fprintf(stdout, "Status:              INVALID (Data may be corrupted)\n");
+		}
+		fprintf(stdout, "\n");
+
+		/* Convert entries from little-endian */
+		for (int i = 0; i < header.entry_count; i++) {
+			entries[i].core_id = le32_to_cpu(entries_le[i].core_id);
+			entries[i].entry_addr = le64_to_cpu(entries_le[i].entry_addr);
+			entries[i].flags = le32_to_cpu(entries_le[i].flags);
+			entries[i].reserved = le32_to_cpu(entries_le[i].reserved);
+		}
+
+		/* Print entries */
+		fprintf(stdout, "Boot Entries:\n");
+		fprintf(stdout, "----------------------------------------\n");
+		fprintf(stdout, "%-8s %-18s %-10s %-10s\n", "Core ID", "Entry Address", "Flags", "Reserved");
+		fprintf(stdout, "%-8s %-18s %-10s %-10s\n", "-------", "-----------------", "----------", "----------");
+
+		for (int i = 0; i < header.entry_count; i++) {
+			fprintf(stdout, "%-8u 0x%016" PRIX64 " 0x%08X 0x%08X\n",
+				entries[i].core_id,
+				entries[i].entry_addr,
+				entries[i].flags,
+				entries[i].reserved);
+		}
+		fprintf(stdout, "\n");
+
+		/* Print hex dump of raw entry data */
+		fprintf(stdout, "Raw Entry Data (Hex Dump):\n");
+		fprintf(stdout, "----------------------------------------\n");
+		uint8_t *raw_data = (uint8_t *)entries_le;
+		for (size_t i = 0; i < entries_data_size; i += 16) {
+			fprintf(stdout, "%04zX: ", i);
+
+			/* Print hex bytes */
+			for (size_t j = 0; j < 16; j++) {
+				if (i + j < entries_data_size) {
+					fprintf(stdout, "%02X ", raw_data[i + j]);
+				} else {
+					fprintf(stdout, "   ");
+				}
+				if (j == 7) fprintf(stdout, " ");
+			}
+
+			fprintf(stdout, " |");
+
+			/* Print ASCII representation */
+			for (size_t j = 0; j < 16; j++) {
+				if (i + j < entries_data_size) {
+					uint8_t c = raw_data[i + j];
+					fprintf(stdout, "%c", (c >= 32 && c <= 126) ? c : '.');
+				}
+			}
+
+			fprintf(stdout, "|\n");
+		}
+		fprintf(stdout, "\n");
+	} else {
+		fprintf(stdout, "No boot entries found in file.\n\n");
+	}
+
+	fprintf(stdout, "========================================\n");
+	fprintf(stdout, "Dump completed successfully\n");
+	fprintf(stdout, "========================================\n");
+	fprintf(stdout, "\n");
+
+cleanup:
+	if (entries_le)
+		free(entries_le);
+	if (entries)
+		free(entries);
+	fclose(fp);
+	return ret;
+}
+
+/**
+ * Parse core ID from string like "core0", "core1", etc.
+ * @param str: Input string
+ * @param core_id: Output core ID
+ * @return: 0 on success, -1 on error
+ */
+int multicore_fastboot_parse_core_id(const char *str, uint32_t *core_id)
+{
+	if (strncmp(str, "core", 4) != 0) {
+		return -1;
+	}
+
+	char *endptr;
+	long id = strtol(str + 4, &endptr, 10);
+
+	/* Check if conversion was successful and entire string was consumed */
+	if (*endptr != '\0' || id < 0 || id > 255) {
+		return -1;
+	}
+
+	*core_id = (uint32_t)id;
+	return 0;
+}
+
+/**
+ * Get the number of boot entries
+ * @return: Number of entries
+ */
+int multicore_fastboot_get_entry_count(void)
+{
+	return fastboot_entry_count;
+}
diff --git a/src/multicore_fastboot.h b/src/multicore_fastboot.h
new file mode 100644
index 0000000..c630651
--- /dev/null
+++ b/src/multicore_fastboot.h
@@ -0,0 +1,121 @@
+/*
+ * Copyright 2026 NXP
+ *
+ * SPDX-License-Identifier:     GPL-2.0+
+ *
+ * Multicore Fast Boot Entry Management
+ */
+
+#ifndef _MULTICORE_FASTBOOT_H_
+#define _MULTICORE_FASTBOOT_H_
+
+#include <stdint.h>
+#include <stdbool.h>
+
+/* Multicore boot entries file format definitions */
+#define FASTBOOT_ENTRIES_MAGIC      0x54425346  /* "FSBT" in ASCII (little-endian) */
+#define FASTBOOT_ENTRIES_VERSION    0x0001
+#define FASTBOOT_ENTRIES_FILE  "fastboot_entries.bin"
+#define MAX_FASTBOOT_ENTRIES        16
+
+/* File header structure - binary format */
+typedef struct {
+	uint32_t magic;          /* Magic number to identify file type */
+	uint32_t total_size;     /* Total file size (header + entries) in bytes */
+	uint16_t version;        /* File format version */
+	uint16_t entry_count;    /* Number of boot entries */
+	uint32_t header_size;    /* Size of this header structure */
+	uint32_t entry_size;     /* Size of each entry structure */
+	uint32_t checksum;       /* CRC32 checksum of entries data */
+	uint32_t reserved[4];    /* Reserved for future use */
+} __attribute__((packed)) fastboot_entries_header_t;
+
+/* Boot entry structure - binary format */
+typedef struct {
+	uint32_t core_id;        /* Cortex-A Core ID */
+	uint64_t entry_addr;     /* Entry address for this core */
+	uint32_t flags;          /* Flags (reserved for future use) */
+	uint32_t reserved;       /* Reserved for alignment */
+} __attribute__((packed)) fastboot_boot_entry_t;
+
+/**
+ * Initialize fastboot boot entries file
+ * Removes existing file if present and resets internal state
+ */
+void multicore_fastboot_init(void);
+
+/**
+ * Add a new multicore boot entry
+ * Entries will be automatically sorted by core_id when written to file
+ * @param core_id: Cortex-A Core ID
+ * @param entry_addr: Entry address for this core
+ * @return: 0 on success, -1 on error
+ */
+int multicore_fastboot_add_entry(uint32_t core_id, uint64_t entry_addr);
+
+/**
+ * Write all boot entries to binary file with header
+ * Entries are sorted by core_id before writing
+ * @return: 0 on success, -1 on error
+ */
+int multicore_fastboot_write_file(void);
+
+/**
+ * Write all boot entries to custom binary file with header
+ * Entries are sorted by core_id before writing
+ * @param filename: Output filename
+ * @return: 0 on success, -1 on error
+ */
+int multicore_fastboot_write_file_custom(const char *filename);
+
+/**
+ * Embed boot entries file into target file at specified offset
+ * @param entries_file: Path to the boot entries file
+ * @param target_file: Path to the target file to embed into
+ * @param offset: Offset in target file where entries should be embedded
+ * @return: 0 on success, -1 on error
+ */
+int multicore_fastboot_embed_entries(const char *entries_file, const char *target_file, uint64_t offset);
+
+/**
+ * Read and validate boot entries from binary file
+ * @param filename: Path to the boot entries file
+ * @return: 0 on success, -1 on error
+ */
+int multicore_fastboot_read_file(const char *filename);
+
+/**
+ * Dump and display fastboot entries from file or embedded location
+ * @param filename: Path to the file containing fastboot entries
+ * @param offset: Offset in file where entries are located (0 for standalone file)
+ * @return: 0 on success, -1 on error
+ */
+int multicore_fastboot_dump_file(const char *filename, uint64_t offset);
+
+/**
+ * Parse core ID from string like "core0", "core1", etc.
+ * @param str: Input string
+ * @param core_id: Output core ID
+ * @return: 0 on success, -1 on error
+ */
+int multicore_fastboot_parse_core_id(const char *str, uint32_t *core_id);
+
+/**
+ * Get the number of boot entries
+ * @return: Number of entries
+ */
+int multicore_fastboot_get_entry_count(void);
+
+/**
+ * Check if a core ID already exists
+ * @param core_id: Core ID to check
+ * @return: true if exists, false otherwise
+ */
+bool multicore_fastboot_is_core_duplicate(uint32_t core_id);
+
+/**
+ * Sort boot entries by core_id in ascending order
+ */
+void multicore_fastboot_sort_entries(void);
+
+#endif /* _MULTICORE_FASTBOOT_H_ */
diff --git a/src/multicore_fastboot_tool.c b/src/multicore_fastboot_tool.c
new file mode 100644
index 0000000..a27d451
--- /dev/null
+++ b/src/multicore_fastboot_tool.c
@@ -0,0 +1,204 @@
+/*
+ * Copyright 2026 NXP
+ *
+ * SPDX-License-Identifier:     GPL-2.0+
+ *
+ * Cortex-A Core Fast Boot Entry Tool - Command Line Interface
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdint.h>
+#include <stdbool.h>
+
+#include "multicore_fastboot.h"
+
+static void print_usage(const char *prog_name)
+{
+	fprintf(stderr, "\nUsage: %s [options]\n\n", prog_name);
+	fprintf(stderr, "Options:\n");
+	fprintf(stderr, "  --core <id> <addr>         - Add boot entry (id: 0-15, addr: hex)\n");
+	fprintf(stderr, "  --output <filename>        - Output filename (default: fastboot_entries.dat)\n");
+	fprintf(stderr, "  --embed <file> <offset>    - Embed entries into file at offset\n");
+	fprintf(stderr, "  --dump <filename>          - Dump and display fastboot entry file contents\n");
+	fprintf(stderr, "  --help                     - Show this help message\n");
+	fprintf(stderr, "\nExamples:\n");
+	fprintf(stderr, "  Create entries:\n");
+	fprintf(stderr, "    %s --core 0 0xD0000000 --core 1 0xD1000000\n", prog_name);
+	fprintf(stderr, "    %s --core 1 0xD0000000 --embed u-boot.bin 0x2000\n", prog_name);
+	fprintf(stderr, "    %s --core 0 0xD0000000 --output custom_entries.dat\n", prog_name);
+	fprintf(stderr, "\n  Dump entries:\n");
+	fprintf(stderr, "    %s --dump fastboot_entries.dat\n", prog_name);
+	fprintf(stderr, "    %s --dump u-boot.bin --offset 0x2000\n\n", prog_name);
+}
+
+int main(int argc, char *argv[])
+{
+	const char *output_file = FASTBOOT_ENTRIES_FILE;
+	const char *embed_file = NULL;
+	const char *dump_file = NULL;
+	uint64_t embed_offset = 0;
+	uint64_t dump_offset = 0;
+	int core_count = 0;
+	bool dump_mode = false;
+
+	if (argc < 2) {
+		fprintf(stderr, "Error: No arguments specified\n");
+		print_usage(argv[0]);
+		return EXIT_FAILURE;
+	}
+
+	/* Parse command line arguments */
+	for (int i = 1; i < argc; i++) {
+		if (strcmp(argv[i], "--help") == 0 || strcmp(argv[i], "-h") == 0) {
+			print_usage(argv[0]);
+			return EXIT_SUCCESS;
+		}
+		else if (strcmp(argv[i], "--dump") == 0) {
+			if (i + 1 >= argc) {
+				fprintf(stderr, "Error: --dump requires 1 argument: <filename>\n");
+				return EXIT_FAILURE;
+			}
+			dump_file = argv[i + 1];
+			dump_mode = true;
+			i += 1;
+		}
+		else if (strcmp(argv[i], "--offset") == 0) {
+			if (i + 1 >= argc) {
+				fprintf(stderr, "Error: --offset requires 1 argument: <offset>\n");
+				return EXIT_FAILURE;
+			}
+			char *endptr;
+			dump_offset = strtoull(argv[i + 1], &endptr, 0);
+			if (*endptr != '\0') {
+				fprintf(stderr, "Error: Invalid offset format '%s'\n", argv[i + 1]);
+				return EXIT_FAILURE;
+			}
+			i += 1;
+		}
+		else if (strcmp(argv[i], "--core") == 0) {
+			if (dump_mode) {
+				fprintf(stderr, "Error: Cannot use --core in dump mode\n");
+				return EXIT_FAILURE;
+			}
+
+			if (i + 2 >= argc) {
+				fprintf(stderr, "Error: --core requires 2 arguments: <id> <addr>\n");
+				return EXIT_FAILURE;
+			}
+
+			/* Parse core ID */
+			char *endptr;
+			long core_id = strtol(argv[i + 1], &endptr, 10);
+			if (*endptr != '\0' || core_id < 0 || core_id > 15) {
+				fprintf(stderr, "Error: Invalid core ID '%s' (must be 0-15)\n", argv[i + 1]);
+				return EXIT_FAILURE;
+			}
+
+			/* Parse entry address */
+			uint64_t entry_addr = strtoull(argv[i + 2], &endptr, 16);
+			if (*endptr != '\0') {
+				fprintf(stderr, "Error: Invalid address format '%s'\n", argv[i + 2]);
+				fprintf(stderr, "Expected hexadecimal address (e.g., 0xD0000000)\n");
+				return EXIT_FAILURE;
+			}
+
+			/* Initialize on first core */
+			if (core_count == 0) {
+				multicore_fastboot_init();
+			}
+
+			/* Add entry */
+			if (multicore_fastboot_add_entry((uint32_t)core_id, entry_addr) != 0) {
+				fprintf(stderr, "Error: Failed to add boot entry for core %ld\n", core_id);
+				return EXIT_FAILURE;
+			}
+
+			fprintf(stdout, "Added boot entry: Core %ld @ 0x%016llX\n", 
+				core_id, (unsigned long long)entry_addr);
+			core_count++;
+
+			i += 2; /* Skip the next 2 arguments */
+		}
+		else if (strcmp(argv[i], "--output") == 0) {
+			if (dump_mode) {
+				fprintf(stderr, "Error: Cannot use --output in dump mode\n");
+				return EXIT_FAILURE;
+			}
+			if (i + 1 >= argc) {
+				fprintf(stderr, "Error: --output requires 1 argument: <filename>\n");
+				return EXIT_FAILURE;
+			}
+			output_file = argv[i + 1];
+			i += 1;
+		}
+		else if (strcmp(argv[i], "--embed") == 0) {
+			if (dump_mode) {
+				fprintf(stderr, "Error: Cannot use --embed in dump mode\n");
+				return EXIT_FAILURE;
+			}
+			if (i + 2 >= argc) {
+				fprintf(stderr, "Error: --embed requires 2 arguments: <file> <offset>\n");
+				return EXIT_FAILURE;
+			}
+			embed_file = argv[i + 1];
+
+			char *endptr;
+			embed_offset = strtoull(argv[i + 2], &endptr, 0);
+			if (*endptr != '\0') {
+				fprintf(stderr, "Error: Invalid offset format '%s'\n", argv[i + 2]);
+				return EXIT_FAILURE;
+			}
+			i += 2;
+		}
+		else {
+			fprintf(stderr, "Error: Unknown option '%s'\n", argv[i]);
+			print_usage(argv[0]);
+			return EXIT_FAILURE;
+		}
+	}
+
+	/* Handle dump mode */
+	if (dump_mode) {
+		if (dump_file == NULL) {
+			fprintf(stderr, "Error: No file specified for dump\n");
+			return EXIT_FAILURE;
+		}
+
+		if (multicore_fastboot_dump_file(dump_file, dump_offset) != 0) {
+			fprintf(stderr, "Error: Failed to dump fastboot entries from %s\n", dump_file);
+			return EXIT_FAILURE;
+		}
+
+		return EXIT_SUCCESS;
+	}
+
+	/* Handle create mode */
+	/* Check if any cores were added */
+	if (core_count == 0) {
+		fprintf(stderr, "Error: No boot entries specified\n");
+		fprintf(stderr, "Use --core option to add at least one entry\n");
+		return EXIT_FAILURE;
+	}
+
+	/* Write entries to file */
+	if (multicore_fastboot_write_file_custom(output_file) != 0) {
+		fprintf(stderr, "Error: Failed to write boot entries file\n");
+		return EXIT_FAILURE;
+	}
+
+	fprintf(stdout, "Boot entries written to %s successfully\n", output_file);
+
+	/* Embed into target file if requested */
+	if (embed_file != NULL) {
+		if (multicore_fastboot_embed_entries(output_file, embed_file, embed_offset) != 0) {
+			fprintf(stderr, "Error: Failed to embed entries into %s\n", embed_file);
+			return EXIT_FAILURE;
+		}
+		fprintf(stdout, "Entries embedded into %s at offset 0x%llX\n",
+			embed_file, (unsigned long long)embed_offset);
+	}
+
+	return EXIT_SUCCESS;
+}
