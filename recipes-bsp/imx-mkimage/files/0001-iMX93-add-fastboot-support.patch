index 0000000..3b4e22e
--- /dev/null
+++ b/scripts/fastboot_helper.mak
@@ -0,0 +1,59 @@
+###########################
+# Fastboot entry processing
+###########################
+define process_fastboot_entries
+	@echo "========================================="
+	@echo "Processing Fastboot Entries"
+	@echo "========================================="
+	@echo "Fastboot configuration: $(fastboot)"
+	@echo "FASTBOOT_ENTRY_EMBEDDED_UBOOT: $(FASTBOOT_ENTRY_EMBEDDED_UBOOT)"
+	@if [ "$(FASTBOOT_ENTRY_EMBEDDED_UBOOT)" = "yes" ]; then \
+		echo "Embedded image: $(FASTBOOT_ENTRY_EMBEDDED_IMG)"; \
+		echo "Embedded offset: $(FASTBOOT_ENTRY_EMBEDDED_OFFSET)"; \
+	else \
+		echo "Dummy image: $(FASTBOOT_ENTRY_DUMMY_IMG)"; \
+	fi
+	@echo "========================================="
+	@# Build command line arguments for the tool
+	@TOOL_ARGS=""; \
+	if [ -n "$(CA_CORE0_IMG)" ] && [ -n "$(CA_CORE0_IMG_LOAD_ADDR)" ]; then \
+		TOOL_ARGS="$$TOOL_ARGS --core 0 $(CA_CORE0_IMG_LOAD_ADDR)"; \
+	fi; \
+	if [ -n "$(CA_CORE1_IMG)" ] && [ -n "$(CA_CORE1_IMG_LOAD_ADDR)" ]; then \
+		TOOL_ARGS="$$TOOL_ARGS --core 1 $(CA_CORE1_IMG_LOAD_ADDR)"; \
+	fi; \
+	if [ -n "$(CA_CORE2_IMG)" ] && [ -n "$(CA_CORE2_IMG_LOAD_ADDR)" ]; then \
+		TOOL_ARGS="$$TOOL_ARGS --core 2 $(CA_CORE2_IMG_LOAD_ADDR)"; \
+	fi; \
+	if [ -n "$(CA_CORE3_IMG)" ] && [ -n "$(CA_CORE3_IMG_LOAD_ADDR)" ]; then \
+		TOOL_ARGS="$$TOOL_ARGS --core 3 $(CA_CORE3_IMG_LOAD_ADDR)"; \
+	fi; \
+	if [ -n "$(CA_CORE4_IMG)" ] && [ -n "$(CA_CORE4_IMG_LOAD_ADDR)" ]; then \
+		TOOL_ARGS="$$TOOL_ARGS --core 4 $(CA_CORE4_IMG_LOAD_ADDR)"; \
+	fi; \
+	if [ -n "$(CA_CORE5_IMG)" ] && [ -n "$(CA_CORE5_IMG_LOAD_ADDR)" ]; then \
+		TOOL_ARGS="$$TOOL_ARGS --core 5 $(CA_CORE5_IMG_LOAD_ADDR)"; \
+	fi; \
+	if [ "$(FASTBOOT_ENTRY_EMBEDDED_UBOOT)" = "yes" ]; then \
+		TOOL_ARGS="$$TOOL_ARGS --embed $(FASTBOOT_ENTRY_EMBEDDED_IMG) $(FASTBOOT_ENTRY_EMBEDDED_OFFSET)"; \
+	else \
+		TOOL_ARGS="$$TOOL_ARGS --output ${FASTBOOT_ENTRY_FILE}"; \
+	fi; \
+	echo "Calling: $(FASTBOOT_TOOL) $$TOOL_ARGS"; \
+	$(FASTBOOT_TOOL) $$TOOL_ARGS
+	@echo "========================================="
+endef
+
+###########################
+# Build fastboot entries string for mkimage
+###########################
+define build_fastboot_entries_string
+$(strip \
+	$(if $(CA_CORE0_IMG), -ap $(CA_CORE0_IMG) a55 $(CA_CORE0_IMG_LOAD_ADDR)) \
+	$(if $(CA_CORE1_IMG), -ap $(CA_CORE1_IMG) a55 $(CA_CORE1_IMG_LOAD_ADDR)) \
+	$(if $(CA_CORE2_IMG), -ap $(CA_CORE2_IMG) a55 $(CA_CORE2_IMG_LOAD_ADDR)) \
+	$(if $(CA_CORE3_IMG), -ap $(CA_CORE3_IMG) a55 $(CA_CORE3_IMG_LOAD_ADDR)) \
+	$(if $(CA_CORE4_IMG), -ap $(CA_CORE4_IMG) a55 $(CA_CORE4_IMG_LOAD_ADDR)) \
+	$(if $(CA_CORE5_IMG), -ap $(CA_CORE5_IMG) a55 $(CA_CORE5_IMG_LOAD_ADDR)) \
+)
+endef
diff --git a/src/multicore_fastboot.c b/src/multicore_fastboot.c
new file mode 100644
index 0000000..c010508
--- /dev/null
+++ b/src/multicore_fastboot.c
@@ -0,0 +1,905 @@
+/*
+ * Copyright 2026 NXP
+ *
+ * SPDX-License-Identifier:     GPL-2.0+
+ *
+ * Multicore Fast Boot Entry Management
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdint.h>
+#include <stdbool.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <inttypes.h>
+
+#include "multicore_fastboot.h"
+#include "mkimage_common.h"
+
+/* Internal state */
+static fastboot_boot_entry_t fastboot_entries[MAX_FASTBOOT_ENTRIES];
+static int fastboot_entry_count = 0;
+
+/* CRC32 lookup table and initialization flag */
+static uint32_t crc32_table[256];
+static bool crc32_table_initialized = false;
+
+/**
+ * Initialize CRC32 lookup table
+ */
+static void init_crc32_table(void)
+{
+	uint32_t polynomial = 0xEDB88320;
+
+	for (uint32_t i = 0; i < 256; i++) {
+		uint32_t crc = i;
+		for (uint32_t j = 0; j < 8; j++) {
+			if (crc & 1)
+				crc = (crc >> 1) ^ polynomial;
+			else
+				crc >>= 1;
+		}
+		crc32_table[i] = crc;
+	}
+	crc32_table_initialized = true;
+}
+
+/**
+ * Calculate CRC32 checksum
+ * @param data: Pointer to data
+ * @param length: Length of data in bytes
+ * @return: CRC32 checksum
+ */
+static uint32_t calculate_crc32(const void *data, size_t length)
+{
+	const uint8_t *bytes = (const uint8_t *)data;
+	uint32_t crc = 0xFFFFFFFF;
+
+	if (!crc32_table_initialized)
+		init_crc32_table();
+
+	for (size_t i = 0; i < length; i++) {
+		uint8_t index = (crc ^ bytes[i]) & 0xFF;
+		crc = (crc >> 8) ^ crc32_table[index];
+	}
+
+	return ~crc;
+}
+
+/**
+ * Comparison function for qsort - sort by core_id in ascending order
+ */
+static int compare_entries_by_core_id(const void *a, const void *b)
+{
+	const fastboot_boot_entry_t *entry_a = (const fastboot_boot_entry_t *)a;
+	const fastboot_boot_entry_t *entry_b = (const fastboot_boot_entry_t *)b;
+
+	if (entry_a->core_id < entry_b->core_id)
+		return -1;
+	else if (entry_a->core_id > entry_b->core_id)
+		return 1;
+	else
+		return 0;
+}
+
+/**
+ * Sort boot entries by core_id in ascending order
+ */
+void multicore_fastboot_sort_entries(void)
+{
+	if (fastboot_entry_count > 1) {
+		qsort(fastboot_entries, fastboot_entry_count, sizeof(fastboot_boot_entry_t),
+		      compare_entries_by_core_id);
+		fprintf(stdout, "Sorted %d Cortex-A Core boot entries by core ID\n",
+			fastboot_entry_count);
+	}
+}
+
+/**
+ * Initialize fastboot boot entries file
+ * Removes existing file if present and resets internal state
+ */
+void multicore_fastboot_init(void)
+{
+	/* Reset entry count and clear entries array */
+	fastboot_entry_count = 0;
+	memset(fastboot_entries, 0, sizeof(fastboot_entries));
+
+	fprintf(stdout, "Initialized Cortex-A Core boot entries\n");
+}
+
+/**
+ * Check if a core ID already exists
+ * @param core_id: Core ID to check
+ * @return: true if exists, false otherwise
+ */
+bool multicore_fastboot_is_core_duplicate(uint32_t core_id)
+{
+	for (int i = 0; i < fastboot_entry_count; i++) {
+		if (fastboot_entries[i].core_id == core_id) {
+			return true;
+		}
+	}
+	return false;
+}
+
+/**
+ * Add a new multicore boot entry
+ * Entries will be automatically sorted by core_id when written to file
+ * @param core_id: Cortex-A Core ID
+ * @param entry_addr: Entry address for this core
+ * @return: 0 on success, -1 on error
+ */
+int multicore_fastboot_add_entry(uint32_t core_id, uint64_t entry_addr)
+{
+	/* Check for duplicate core ID */
+	if (multicore_fastboot_is_core_duplicate(core_id)) {
+		fprintf(stderr, "Error: Cortex-A Core ID %u overlaps with existing entry\n", 
+			core_id);
+		return -1;
+	}
+
+	/* Check if we exceeded max entries */
+	if (fastboot_entry_count >= MAX_FASTBOOT_ENTRIES) {
+		fprintf(stderr, "Error: Maximum number of Cortex-A Core entries (%d) exceeded\n",
+			MAX_FASTBOOT_ENTRIES);
+		return -1;
+	}
+
+	/* Store entry in memory */
+	fastboot_entries[fastboot_entry_count].core_id = core_id;
+	fastboot_entries[fastboot_entry_count].entry_addr = entry_addr;
+	fastboot_entries[fastboot_entry_count].flags = 0;
+	fastboot_entries[fastboot_entry_count].reserved = 0;
+	fastboot_entry_count++;
+
+	return 0;
+}
+
+/**
+ * Write all boot entries to binary file with header
+ * Entries are sorted by core_id before writing
+ * @return: 0 on success, -1 on error
+ */
+int multicore_fastboot_write_file(void)
+{
+	return multicore_fastboot_write_file_custom(FASTBOOT_ENTRIES_FILE);
+}
+
+/**
+ * Write all boot entries to custom binary file with header
+ * Entries are sorted by core_id before writing
+ * @param filename: Output filename
+ * @return: 0 on success, -1 on error
+ */
+int multicore_fastboot_write_file_custom(const char *filename)
+{
+	FILE *fp;
+	fastboot_entries_header_t header;
+	uint32_t checksum;
+	size_t entries_data_size;
+	fastboot_boot_entry_t *entries_le = NULL;
+	int ret = 0;
+
+	/* Sort entries by core_id before writing */
+	multicore_fastboot_sort_entries();
+
+	/* Calculate entries data size */
+	entries_data_size = fastboot_entry_count * sizeof(fastboot_boot_entry_t);
+
+	/* Allocate temporary buffer for little-endian conversion */
+	if (fastboot_entry_count > 0) {
+		entries_le = malloc(entries_data_size);
+		if (entries_le == NULL) {
+			fprintf(stderr, "Error: Memory allocation failed\n");
+			return -1;
+		}
+
+		/* Convert entries to little-endian */
+		for (int i = 0; i < fastboot_entry_count; i++) {
+			entries_le[i].core_id = cpu_to_le32(fastboot_entries[i].core_id);
+			entries_le[i].entry_addr = cpu_to_le64(fastboot_entries[i].entry_addr);
+			entries_le[i].flags = cpu_to_le32(fastboot_entries[i].flags);
+			entries_le[i].reserved = cpu_to_le32(fastboot_entries[i].reserved);
+		}
+
+		/* Calculate checksum of little-endian entries data */
+		checksum = calculate_crc32(entries_le, entries_data_size);
+	} else {
+		checksum = 0;
+	}
+
+	/* Prepare header in little-endian format */
+	memset(&header, 0, sizeof(header));
+	header.magic = cpu_to_le32(FASTBOOT_ENTRIES_MAGIC);
+	header.version = cpu_to_le16(FASTBOOT_ENTRIES_VERSION);
+	header.entry_count = cpu_to_le16(fastboot_entry_count);
+	header.header_size = cpu_to_le32(sizeof(fastboot_entries_header_t));
+	header.entry_size = cpu_to_le32(sizeof(fastboot_boot_entry_t));
+	header.total_size = cpu_to_le32(sizeof(header) + entries_data_size);
+	header.checksum = cpu_to_le32(checksum);
+
+	/* Open file for binary writing */
+	fp = fopen(filename, "wb");
+	if (fp == NULL) {
+		fprintf(stderr, "Error: Failed to create %s\n", filename);
+		if (entries_le)
+			free(entries_le);
+		return -1;
+	}
+
+	/* Write header */
+	if (fwrite(&header, sizeof(header), 1, fp) != 1) {
+		fprintf(stderr, "Error: Failed to write header to %s\n", filename);
+		ret = -1;
+		goto cleanup;
+	}
+
+	/* Write entries */
+	if (fastboot_entry_count > 0) {
+		if (fwrite(entries_le, entries_data_size, 1, fp) != 1) {
+			fprintf(stderr, "Error: Failed to write entries to %s\n", filename);
+			ret = -1;
+			goto cleanup;
+		}
+	}
+
+	fprintf(stdout, "\n");
+	fprintf(stdout, "========================================\n");
+	fprintf(stdout, "Cortex-A Core Boot Entries File Summary\n");
+	fprintf(stdout, "========================================\n");
+	fprintf(stdout, "File: %s\n", filename);
+	fprintf(stdout, "Format: Binary\n");
+	fprintf(stdout, "Magic: 0x%08X ('FSBT')\n", FASTBOOT_ENTRIES_MAGIC);
+	fprintf(stdout, "Version: 0x%04X\n", FASTBOOT_ENTRIES_VERSION);
+	fprintf(stdout, "Entry count: %d\n", fastboot_entry_count);
+	fprintf(stdout, "Header size: %zu bytes\n", sizeof(header));
+	fprintf(stdout, "Entry size: %zu bytes\n", sizeof(fastboot_boot_entry_t));
+	fprintf(stdout, "Total size: %zu bytes\n", sizeof(header) + entries_data_size);
+	fprintf(stdout, "Checksum: 0x%08X\n", checksum);
+	fprintf(stdout, "----------------------------------------\n");
+	fprintf(stdout, "Boot Entries (sorted by Core ID):\n");
+	for (int i = 0; i < fastboot_entry_count; i++) {
+		fprintf(stdout, "  Core %u: 0x%016" PRIX64 "\n",
+			fastboot_entries[i].core_id, fastboot_entries[i].entry_addr);
+	}
+	fprintf(stdout, "========================================\n");
+	fprintf(stdout, "\n");
+
+cleanup:
+	if (entries_le)
+		free(entries_le);
+	fclose(fp);
+	return ret;
+}
+
+/**
+ * Embed boot entries file into target file at specified offset
+ * Creates a new file with "-fastboot" suffix instead of overwriting the original
+ * Validates that the target file has proper magic number and sufficient reserved space
+ * @param entries_file: Path to the boot entries file
+ * @param target_file: Path to the target file to embed into
+ * @param offset: Offset in target file where entries should be embedded
+ * @return: 0 on success, -1 on error
+ */
+int multicore_fastboot_embed_entries(const char *entries_file, const char *target_file, uint64_t offset)
+{
+	FILE *entries_fp = NULL;
+	FILE *target_fp = NULL;
+	FILE *output_fp = NULL;
+	struct stat st;
+	uint8_t *entries_data = NULL;
+	uint8_t *target_data = NULL;
+	char *output_file = NULL;
+	size_t target_size;
+	uint32_t magic_at_offset;
+	uint32_t reserved_space_size;
+	int ret = 0;
+
+	/* Check if entries file exists */
+	if (stat(entries_file, &st) != 0) {
+		fprintf(stderr, "Error: Entries file %s does not exist\n", entries_file);
+		return -1;
+	}
+
+	size_t entries_size = st.st_size;
+
+	/* Check if target file exists */
+	if (stat(target_file, &st) != 0) {
+		fprintf(stderr, "Error: Target file %s does not exist\n", target_file);
+		return -1;
+	}
+
+	target_size = st.st_size;
+
+	/* Check if offset is valid (need at least 8 bytes for magic + size) */
+	if (offset + 8 > (uint64_t)target_size) {
+		fprintf(stderr, "Error: Offset 0x%llX + 8 bytes exceeds target file size %zu\n",
+			(unsigned long long)offset, target_size);
+		return -1;
+	}
+
+	/* Read target file */
+	target_fp = fopen(target_file, "rb");
+	if (target_fp == NULL) {
+		fprintf(stderr, "Error: Failed to open %s for reading\n", target_file);
+		return -1;
+	}
+
+	target_data = malloc(target_size);
+	if (target_data == NULL) {
+		fprintf(stderr, "Error: Memory allocation failed\n");
+		fclose(target_fp);
+		return -1;
+	}
+
+	if (fread(target_data, target_size, 1, target_fp) != 1) {
+		fprintf(stderr, "Error: Failed to read %s\n", target_file);
+		free(target_data);
+		fclose(target_fp);
+		return -1;
+	}
+	fclose(target_fp);
+	target_fp = NULL;
+
+	/* Validate magic number at offset (first 32 bits) */
+	memcpy(&magic_at_offset, target_data + offset, sizeof(uint32_t));
+	magic_at_offset = le32_to_cpu(magic_at_offset);
+
+	if (magic_at_offset != FASTBOOT_ENTRIES_MAGIC) {
+		fprintf(stderr, "Error: Invalid magic number at offset 0x%llX in %s\n",
+			(unsigned long long)offset, target_file);
+		fprintf(stderr, "       Found: 0x%08X, Expected: 0x%08X ('FSBT')\n",
+			magic_at_offset, FASTBOOT_ENTRIES_MAGIC);
+		fprintf(stderr, "       Target file does not have a valid fastboot entries reservation\n");
+		fprintf(stderr, "       If target file is a u-boot image, ensure CONFIG_EMBEDDED_FASTBOOT_BLOB is enabled\n");
+		free(target_data);
+		return -1;
+	}
+
+	/* Read reserved space size (second 32 bits) */
+	memcpy(&reserved_space_size, target_data + offset + 4, sizeof(uint32_t));
+	reserved_space_size = le32_to_cpu(reserved_space_size);
+
+	/* Validate reserved space size */
+	if (reserved_space_size < entries_size) {
+		fprintf(stderr, "Error: Reserved space at offset 0x%llX is too small\n",
+			(unsigned long long)offset);
+		fprintf(stderr, "       Reserved: %u bytes, Required: %zu bytes\n",
+			reserved_space_size, entries_size);
+		fprintf(stderr, "       Entries file is %zu bytes larger than reserved space\n",
+			entries_size - reserved_space_size);
+		fprintf(stderr, "       If target file is a u-boot image, set reserved space by\n");
+		fprintf(stderr, "       configuring CONFIG_EMBEDDED_FASTBOOT_BLOB_SIZE\n");
+		free(target_data);
+		return -1;
+	}
+
+	/* Check if reserved space fits within target file */
+	if (offset + reserved_space_size > (uint64_t)target_size) {
+		fprintf(stderr, "Error: Reserved space (offset 0x%llX + %u bytes) exceeds target file size %zu\n",
+			(unsigned long long)offset, reserved_space_size, target_size);
+		free(target_data);
+		return -1;
+	}
+
+	fprintf(stdout, "Validation successful:\n");
+	fprintf(stdout, "  Magic number: 0x%08X ('FSBT') [VALID]\n", magic_at_offset);
+	fprintf(stdout, "  Reserved space: %u bytes\n", reserved_space_size);
+	fprintf(stdout, "  Entries size: %zu bytes\n", entries_size);
+	fprintf(stdout, "  Available space: %u bytes\n", reserved_space_size - (uint32_t)entries_size);
+	fprintf(stdout, "\n");
+
+	/* Generate output filename with "-fastboot" suffix */
+	const char *dot = strrchr(target_file, '.');
+	const char *slash = strrchr(target_file, '/');
+
+	/* Find the position to insert "-fastboot" */
+	if (dot != NULL && (slash == NULL || dot > slash)) {
+		/* Has extension: insert before the extension */
+		size_t base_len = dot - target_file;
+		size_t ext_len = strlen(dot);
+		output_file = malloc(base_len + strlen("-fastboot") + ext_len + 1);
+		if (output_file == NULL) {
+			fprintf(stderr, "Error: Memory allocation failed\n");
+			free(target_data);
+			return -1;
+		}
+		strncpy(output_file, target_file, base_len);
+		output_file[base_len] = '\0';
+		strcat(output_file, "-fastboot");
+		strcat(output_file, dot);
+	} else {
+		/* No extension: append "-fastboot" to the end */
+		output_file = malloc(strlen(target_file) + strlen("-fastboot") + 1);
+		if (output_file == NULL) {
+			fprintf(stderr, "Error: Memory allocation failed\n");
+			free(target_data);
+			return -1;
+		}
+		strcpy(output_file, target_file);
+		strcat(output_file, "-fastboot");
+	}
+
+	/* Read entries file */
+	entries_fp = fopen(entries_file, "rb");
+	if (entries_fp == NULL) {
+		fprintf(stderr, "Error: Failed to open %s\n", entries_file);
+		ret = -1;
+		goto cleanup;
+	}
+
+	entries_data = malloc(entries_size);
+	if (entries_data == NULL) {
+		fprintf(stderr, "Error: Memory allocation failed\n");
+		ret = -1;
+		goto cleanup;
+	}
+
+	if (fread(entries_data, entries_size, 1, entries_fp) != 1) {
+		fprintf(stderr, "Error: Failed to read %s\n", entries_file);
+		ret = -1;
+		goto cleanup;
+	}
+	fclose(entries_fp);
+	entries_fp = NULL;
+
+	/* Embed entries data into target data at specified offset */
+	memcpy(target_data + offset, entries_data, entries_size);
+
+	/* Write to output file */
+	output_fp = fopen(output_file, "wb");
+	if (output_fp == NULL) {
+		fprintf(stderr, "Error: Failed to create %s\n", output_file);
+		ret = -1;
+		goto cleanup;
+	}
+
+	if (fwrite(target_data, target_size, 1, output_fp) != 1) {
+		fprintf(stderr, "Error: Failed to write to %s\n", output_file);
+		ret = -1;
+		goto cleanup;
+	}
+
+	fprintf(stdout, "Successfully embedded %zu bytes from %s into %s at offset 0x%llX\n",
+		entries_size, entries_file, output_file, (unsigned long long)offset);
+	fprintf(stdout, "Output file: %s\n", output_file);
+
+cleanup:
+	if (entries_data)
+		free(entries_data);
+	if (target_data)
+		free(target_data);
+	if (output_file)
+		free(output_file);
+	if (entries_fp)
+		fclose(entries_fp);
+	if (target_fp)
+		fclose(target_fp);
+	if (output_fp)
+		fclose(output_fp);
+
+	return ret;
+}
