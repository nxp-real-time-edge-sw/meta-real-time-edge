+    timer_np = of_parse_phandle(si->pdev->dev.of_node, "nxp,ptp-timer", 0);
+    if (!timer_np)
+        return enetc4_get_default_timer_pdev(si);
+
+    timer_fwnode = of_fwnode_handle(timer_np);
+    of_node_put(timer_np);
+    if (!timer_fwnode)
+        return NULL;
+
+    return to_pci_dev(timer_fwnode->dev);
+}
