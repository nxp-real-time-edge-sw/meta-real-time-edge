+};
+
+struct isit_resp_query {
+	__le32 status;
+	__le32 entry_id;
+	struct isit_keye_data keye;
+	__le32 is_eid;
+};
+
+/* Ingress Stream Table version 0 Resquet and Response Data Buffer Format */
+struct ist_req_ua {
