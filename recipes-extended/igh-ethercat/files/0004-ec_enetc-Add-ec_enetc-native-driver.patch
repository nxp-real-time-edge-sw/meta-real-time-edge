++    int err;
++
++    val = enetc_port_rd(hw, ENETC4_MMCSR);
++    if (!(val & MMCSR_ME))
++        goto out;
++
++    if (!(val & MMCSR_VDIS)) {
++        err = enetc4_mm_wait_tx_active(hw, FIELD_GET(MMCSR_VT, val));
++        if (err)
++            goto out;
++    }
++
++    preemptible_tcs = priv->preemptible_tcs;
++
++out:
++    enetc_port_wr(hw, ENETC4_PFPCR, preemptible_tcs);
