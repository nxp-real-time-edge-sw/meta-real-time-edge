++    .tx_csum = true,
++    .shared_tx_rings = true,
++    .max_frags = ENETC4_MAX_SKB_FRAGS,
++    .pmac_offset = ENETC4_PMAC_OFFSET,
++    .eth_ops = &enetc4_pf_ethtool_ops,
++};
++
++static const struct enetc_drvdata enetc4_ppm_data = {
