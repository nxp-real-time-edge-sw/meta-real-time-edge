+};
+
+/* Ingress Stream filter Table Resquet and Response Data Buffer Format */
+struct isft_ak_eid {
+	__le32 entry_id;
+	__le32 resv;
+};
+
+struct isft_ak_search {
+	__le32 resume_eid;
+	__le32 resv;
+};
+
