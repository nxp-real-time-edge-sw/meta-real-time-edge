+      .dev_id = NXP_ENETC_PPM_DEV_ID,
+      .data = &enetc4_ppm_data,
+    },
+    { .revision = ENETC_REV_4_3,
+      .dev_id = NXP_ENETC_PF_DEV_ID,
+      .data = &enetc4_pf_data,
