+/**
+ * ethtool_mm_get - Get MAC Merge layer status
+ * @ifname: Interface name
+ * @supported: Output - whether MAC Merge is supported by the device
+ * @enabled: Output - whether preemption is administratively enabled
+ * @active: Output - whether preemption is operationally active
+ *
+ * Query the MAC Merge layer status for a network interface.
+ * A device supports MAC Merge if it has both eMAC and pMAC.
+ * Preemption is enabled if both pmac_enabled and tx_enabled are true.
+ * Preemption is active if tx_active is true (verification succeeded).
+ *
+ * Returns 0 on success, -1 on error.
+ */
+int ethtool_mm_get(const char *ifname, struct lldpd_dot3_mm *mm);
+
+/**
+ * ethtool_mm_reset - Enable or disable MAC Merge preemption
+ * @ifname: Interface name
+ * @enable: true to enable preemption, false to disable
+ *
+ * When enabling preemption, this function performs a clean reset:
+ * 1. Retrieves current MAC Merge configuration
+ * 2. Disables preemption completely
+ * 3. Re-enables preemption with the saved configuration
+ *
+ * This ensures proper state transition and verification process.
+ *
+ * When disabling, simply turns off all MAC Merge features.
+ *
+ * Returns 0 on success, -1 on error.
+ */
+#ifdef HAVE_LIBMNL
+int ethtool_mm_reset(const char *ifname, bool enable);
+#else
+static inline int ethtool_mm_reset(const char *ifname, bool enable)
+{
+    return -1;
+}
+#endif /* HAVE_LIBMNL */
+#endif /* _ETHTOOL_MM_H */
