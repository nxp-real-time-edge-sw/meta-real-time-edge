+static int lldp_link_reset(struct lldpd *cfg, char *ifname)
+{
+    struct ifreq ifr;
+
+    memset(&ifr, 0, sizeof(ifr));
+    strlcpy(ifr.ifr_name, ifname, IFNAMSIZ);
+    if (ioctl(cfg->g_sock, SIOCGIFFLAGS, &ifr) < 0) {
+        log_warn("lldp", "failed to get interface flags for %s", ifname);
+	return -1;
+    }
+    ifr.ifr_flags &= ~IFF_UP;
+    if (ioctl(cfg->g_sock, SIOCSIFFLAGS, &ifr) < 0) {
+        log_warn("lldp", "failed to bring down interface %s", ifname);
+	return -1;
+    }
+    usleep(100000);
+    ifr.ifr_flags |= IFF_UP;
+    if (ioctl(cfg->g_sock, SIOCSIFFLAGS, &ifr) < 0) {
+        log_warn("lldp", "failed to bring up interface %s", ifname);
+	return -1;
+    }
+    log_debug("lldp", "reset the interface %s successfully", ifname);
+
+    return 0;
+}
