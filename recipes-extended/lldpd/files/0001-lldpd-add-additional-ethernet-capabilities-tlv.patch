+#include <stdio.h>
+#include <string.h>
+#include <errno.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include <time.h>
+
+#include <linux/genetlink.h>
+//#include <linux/ethtool_netlink.h>
+#include <linux/ethtool_netlink_generated.h>
+#include <linux/netlink.h>
+
+#include <libmnl/libmnl.h>
+
+#include "ethtool-mm.h"
+#include "../log.h"
+
+#define NL_BUFSIZE 8192
+#define DIV_ROUND_UP(n, d) (((n)+(d)-1) / (d))
+
+/* MAC Merge configuration structure */
+struct mm_config {
+	uint8_t verify_enabled;
+	uint8_t tx_enabled;
+	uint8_t pmac_enabled;
+	uint32_t verify_time;
+	uint32_t tx_min_frag_size;
+};
+
+static int
+genl_resolve_family(struct mnl_socket *nl, const char *family)
+{
+	char buf[NL_BUFSIZE];
+	struct nlmsghdr *nlh;
+	struct genlmsghdr *genl;
+	uint32_t seq;
+	int ret;
+
+	nlh = mnl_nlmsg_put_header(buf);
+	nlh->nlmsg_type = GENL_ID_CTRL;
+	nlh->nlmsg_flags = NLM_F_REQUEST;
+	nlh->nlmsg_seq = seq = time(NULL);
+
+	genl = mnl_nlmsg_put_extra_header(nlh, sizeof(*genl));
+	genl->cmd = CTRL_CMD_GETFAMILY;
+	genl->version = 1;
+
+	mnl_attr_put_strz(nlh, CTRL_ATTR_FAMILY_NAME, family);
+
+	if (mnl_socket_sendto(nl, nlh, nlh->nlmsg_len) < 0) {
+		log_warn("ethtool-mm", "failed to send netlink message");
+		return -1;
+	}
+
+	ret = mnl_socket_recvfrom(nl, buf, sizeof(buf));
+	if (ret <= 0) {
+		log_warn("ethtool-mm", "failed to receive netlink response");
+		return -1;
+	}
+
+	nlh = (struct nlmsghdr *)buf;
+	genl = mnl_nlmsg_get_payload(nlh);
+
+	struct nlattr *attr;
+	int family_id = -1;
+
+	mnl_attr_for_each(attr, nlh, sizeof(*genl)) {
+		if (mnl_attr_get_type(attr) == CTRL_ATTR_FAMILY_ID) {
+			family_id = mnl_attr_get_u16(attr);
+			break;
+		}
+	}
+
+	if (family_id < 0) {
+		log_warnx("ethtool-mm", "failed to resolve generic netlink family");
+	}
+
+	return family_id;
+}
+
+/**
+ * ethtool_mm_get - Get MAC Merge layer status
+ * @ifname: Interface name
+ * @supported: Output - whether MAC Merge is supported
+ * @enabled: Output - whether preemption is administratively enabled
+ * @active: Output - whether preemption is operationally active
+ *
+ * Returns 0 on success, -1 on error.
+ */
+int
+ethtool_mm_get(const char *ifname, struct lldpd_dot3_mm *mm)
+{
+	struct mnl_socket *nl = NULL;
+	char buf[NL_BUFSIZE];
+	struct nlmsghdr *nlh;
+	struct genlmsghdr *genl;
+	uint32_t seq, min_frag_size = 0;
+	int family, ret = -1;
+	uint8_t pmac_enabled = 0;
+	uint8_t tx_enabled = 0;
+	uint8_t tx_active = 0;
+
+	if (!mm) {
+		log_warnx("ethtool-mm", "invalid parameters");
+		return -1;
+	}
+
+	mm->support = false;
+	mm->status = false;
+	mm->active = false;
+	mm->frag_size = 0;
+
+	nl = mnl_socket_open(NETLINK_GENERIC);
+	if (!nl) {
+		log_warn("ethtool-mm", "failed to open netlink socket");
+		return -1;
+	}
+
+	if (mnl_socket_bind(nl, 0, MNL_SOCKET_AUTOPID) < 0) {
+		log_warn("ethtool-mm", "failed to bind netlink socket");
+		goto out;
+	}
+
+	family = genl_resolve_family(nl, "ethtool");
+	if (family < 0) {
+		log_warnx("ethtool-mm", "ethtool netlink family not available");
+		goto out;
+	}
+
+	memset(buf, 0, sizeof(buf));
+	nlh = mnl_nlmsg_put_header(buf);
+	nlh->nlmsg_type = family;
+	nlh->nlmsg_flags = NLM_F_REQUEST;
+	nlh->nlmsg_seq = seq = time(NULL);
+
+	genl = mnl_nlmsg_put_extra_header(nlh, sizeof(*genl));
+	genl->cmd = ETHTOOL_MSG_MM_GET;
+	genl->version = ETHTOOL_GENL_VERSION;
+
+	/* Add header with device name */
+	struct nlattr *nest = mnl_attr_nest_start(nlh, ETHTOOL_A_MM_HEADER);
+	mnl_attr_put_strz(nlh, ETHTOOL_A_HEADER_DEV_NAME, ifname);
+	mnl_attr_nest_end(nlh, nest);
+
+	if (mnl_socket_sendto(nl, nlh, nlh->nlmsg_len) < 0) {
+		log_warn("ethtool-mm", "failed to send MM_GET request for %s", ifname);
+		goto out;
+	}
+
+	ret = mnl_socket_recvfrom(nl, buf, sizeof(buf));
+	if (ret <= 0) {
+		/* Device might not support MAC Merge, which is not an error */
+		log_debug("ethtool-mm", "no response for %s (likely not supported)", ifname);
+		ret = 0; /* Not an error, just not supported */
+		goto out;
+	}
+
+	nlh = (struct nlmsghdr *)buf;
+	
+	/* Check for error response */
+	if (nlh->nlmsg_type == NLMSG_ERROR) {
+		struct nlmsgerr *err = mnl_nlmsg_get_payload(nlh);
+		if (err->error != 0) {
+			log_debug("ethtool-mm", "MM not supported on %s (error: %d)", 
+				  ifname, -err->error);
+			ret = 0; /* Not an error, just not supported */
+			goto out;
+		}
+	}
+
+	genl = mnl_nlmsg_get_payload(nlh);
+	struct nlattr *attr;
+
+	mnl_attr_for_each(attr, nlh, sizeof(*genl)) {
+		int type = mnl_attr_get_type(attr);
+		
+		switch (type) {
+		case ETHTOOL_A_MM_PMAC_ENABLED:
+			pmac_enabled = mnl_attr_get_u8(attr);
+			mm->support = true;
+			break;
+		case ETHTOOL_A_MM_TX_ENABLED:
+			tx_enabled = mnl_attr_get_u8(attr);
+			break;
+		case ETHTOOL_A_MM_TX_ACTIVE:
+			tx_active = mnl_attr_get_u8(attr);
+			break;
+		case ETHTOOL_A_MM_TX_MIN_FRAG_SIZE:
+			min_frag_size = mnl_attr_get_u32(attr);
+			break;
+		default:
+			break;
+		}
+	}
+
+	/* Device supports MAC Merge if we got valid response */
+	if (mm->support) {
+		mm->status = (pmac_enabled && tx_enabled);
+		mm->active = tx_active;
+		mm->frag_size = DIV_ROUND_UP(min_frag_size, 64) - 1;;
+		log_debug("ethtool-mm", "%s: supported=%d, enabled=%d, active=%d",
+			  ifname, mm->support, mm->status, mm->active);
+	}
+
+	ret = 0;
+
+out:
+	if (nl)
+		mnl_socket_close(nl);
+	return ret;
+}
+
+/**
+ * ethtool_mm_get_config - Get current MAC Merge configuration
+ * @ifname: Interface name
+ * @config: Output configuration structure
+ *
+ * Returns 0 on success, -1 on error.
+ */
+static int
+ethtool_mm_get_config(const char *ifname, struct mm_config *config)
+{
+	struct mnl_socket *nl = NULL;
+	char buf[NL_BUFSIZE];
+	struct nlmsghdr *nlh;
+	struct genlmsghdr *genl;
+	uint32_t seq;
+	int family, ret = -1;
+
+	if (!ifname || !config) {
+		log_warnx("ethtool-mm", "invalid parameters");
+		return -1;
+	}
+
+	memset(config, 0, sizeof(*config));
+
+	nl = mnl_socket_open(NETLINK_GENERIC);
+	if (!nl) {
+		log_warn("ethtool-mm", "failed to open netlink socket");
+		return -1;
+	}
+
+	if (mnl_socket_bind(nl, 0, MNL_SOCKET_AUTOPID) < 0) {
+		log_warn("ethtool-mm", "failed to bind netlink socket");
+		goto out;
+	}
+
+	family = genl_resolve_family(nl, "ethtool");
+	if (family < 0)
+		goto out;
+
+	memset(buf, 0, sizeof(buf));
+	nlh = mnl_nlmsg_put_header(buf);
+	nlh->nlmsg_type = family;
+	nlh->nlmsg_flags = NLM_F_REQUEST;
+	nlh->nlmsg_seq = seq = time(NULL);
+
+	genl = mnl_nlmsg_put_extra_header(nlh, sizeof(*genl));
+	genl->cmd = ETHTOOL_MSG_MM_GET;
+	genl->version = ETHTOOL_GENL_VERSION;
+
+	struct nlattr *nest = mnl_attr_nest_start(nlh, ETHTOOL_A_MM_HEADER);
+	mnl_attr_put_strz(nlh, ETHTOOL_A_HEADER_DEV_NAME, ifname);
+	mnl_attr_nest_end(nlh, nest);
+
+	if (mnl_socket_sendto(nl, nlh, nlh->nlmsg_len) < 0) {
+		log_warn("ethtool-mm", "failed to send MM_GET request");
+		goto out;
+	}
+
+	ret = mnl_socket_recvfrom(nl, buf, sizeof(buf));
+	if (ret <= 0) {
+		log_warn("ethtool-mm", "failed to receive MM_GET response");
+		goto out;
+	}
+
+	nlh = (struct nlmsghdr *)buf;
+	genl = mnl_nlmsg_get_payload(nlh);
+
+	struct nlattr *attr;
+	mnl_attr_for_each(attr, nlh, sizeof(*genl)) {
+		int type = mnl_attr_get_type(attr);
+		
+		switch (type) {
+		case ETHTOOL_A_MM_VERIFY_ENABLED:
+			config->verify_enabled = mnl_attr_get_u8(attr);
+			break;
+		case ETHTOOL_A_MM_TX_ENABLED:
+			config->tx_enabled = mnl_attr_get_u8(attr);
+			break;
+		case ETHTOOL_A_MM_PMAC_ENABLED:
+			config->pmac_enabled = mnl_attr_get_u8(attr);
+			break;
+		case ETHTOOL_A_MM_VERIFY_TIME:
+			config->verify_time = mnl_attr_get_u32(attr);
+			break;
+		case ETHTOOL_A_MM_TX_MIN_FRAG_SIZE:
+			config->tx_min_frag_size = mnl_attr_get_u32(attr);
+			break;
+		default:
+			break;
+		}
+	}
+
+	ret = 0;
+
+out:
+	if (nl)
+		mnl_socket_close(nl);
+	return ret;
+}
+
+/**
+ * ethtool_mm_set_config - Set MAC Merge configuration
+ * @ifname: Interface name
+ * @config: Configuration to apply
+ *
+ * Returns 0 on success, -1 on error.
+ */
+static int
+ethtool_mm_set_config(const char *ifname, const struct mm_config *config)
+{
+	struct mnl_socket *nl = NULL;
+	char buf[NL_BUFSIZE];
+	struct nlmsghdr *nlh;
+	struct genlmsghdr *genl;
+	uint32_t seq;
+	int family, ret = -1;
+
+	if (!ifname || !config) {
+		log_warnx("ethtool-mm", "invalid parameters");
+		return -1;
+	}
+
+	nl = mnl_socket_open(NETLINK_GENERIC);
+	if (!nl) {
+		log_warn("ethtool-mm", "failed to open netlink socket");
+		return -1;
+	}
+
+	if (mnl_socket_bind(nl, 0, MNL_SOCKET_AUTOPID) < 0) {
+		log_warn("ethtool-mm", "failed to bind netlink socket");
+		goto out;
+	}
+
+	family = genl_resolve_family(nl, "ethtool");
+	if (family < 0)
+		goto out;
+
+	memset(buf, 0, sizeof(buf));
+	nlh = mnl_nlmsg_put_header(buf);
+	nlh->nlmsg_type = family;
+	nlh->nlmsg_flags = NLM_F_REQUEST | NLM_F_ACK;
+	nlh->nlmsg_seq = seq = time(NULL);
+
+	genl = mnl_nlmsg_put_extra_header(nlh, sizeof(*genl));
+	genl->cmd = ETHTOOL_MSG_MM_SET;
+	genl->version = ETHTOOL_GENL_VERSION;
+
+	struct nlattr *nest = mnl_attr_nest_start(nlh, ETHTOOL_A_MM_HEADER);
+	mnl_attr_put_strz(nlh, ETHTOOL_A_HEADER_DEV_NAME, ifname);
+	mnl_attr_nest_end(nlh, nest);
+
+	/* Set all configuration parameters */
+	mnl_attr_put_u8(nlh, ETHTOOL_A_MM_VERIFY_ENABLED, config->verify_enabled);
+	mnl_attr_put_u8(nlh, ETHTOOL_A_MM_TX_ENABLED, config->tx_enabled);
+	mnl_attr_put_u8(nlh, ETHTOOL_A_MM_PMAC_ENABLED, config->pmac_enabled);
+	
+	if (config->verify_time > 0)
+		mnl_attr_put_u32(nlh, ETHTOOL_A_MM_VERIFY_TIME, config->verify_time);
+	
+	if (config->tx_min_frag_size > 0)
+		mnl_attr_put_u32(nlh, ETHTOOL_A_MM_TX_MIN_FRAG_SIZE, 
+				 config->tx_min_frag_size);
+
+	if (mnl_socket_sendto(nl, nlh, nlh->nlmsg_len) < 0) {
+		log_warn("ethtool-mm", "failed to send MM_SET request");
+		goto out;
+	}
+
+	/* Wait for ACK */
+	ret = mnl_socket_recvfrom(nl, buf, sizeof(buf));
+	if (ret <= 0) {
+		log_warn("ethtool-mm", "failed to receive MM_SET response");
+		goto out;
+	}
+
+	nlh = (struct nlmsghdr *)buf;
+	if (nlh->nlmsg_type == NLMSG_ERROR) {
+		struct nlmsgerr *err = mnl_nlmsg_get_payload(nlh);
+		if (err->error != 0) {
+			log_warnx("ethtool-mm", "MM_SET failed with error: %d", 
+				  -err->error);
+			goto out;
+		}
+	}
+
+	ret = 0;
+
+out:
+	if (nl)
+		mnl_socket_close(nl);
+	return ret;
+}
+
+/**
+ * ethtool_mm_reset - Enable or disable MAC Merge preemption
+ * @ifname: Interface name
+ * @enable: true to enable, false to disable
+ *
+ * When enabling, this function:
+ * 1. Gets current configuration
+ * 2. Disables preemption
+ * 3. Re-enables with saved configuration
+ *
+ * This ensures a clean state transition.
+ *
+ * Returns 0 on success, -1 on error.
+ */
+int
+ethtool_mm_reset(const char *ifname, bool enable)
+{
+	struct mm_config config;
+	struct mm_config disable_config;
+	int ret;
+
+	if (!ifname) {
+		log_warnx("ethtool-mm", "invalid interface name");
+		return -1;
+	}
+
+	if (enable) {
+		/* Step 1: Get current configuration */
+		log_debug("ethtool-mm", "getting current configuration for %s", ifname);
+		ret = ethtool_mm_get_config(ifname, &config);
+		if (ret < 0) {
+			log_warnx("ethtool-mm", "failed to get current config for %s", 
+				  ifname);
+			return -1;
+		}
+
+		/* Step 2: Disable preemption first */
+		log_debug("ethtool-mm", "disabling preemption on %s", ifname);
+		memset(&disable_config, 0, sizeof(disable_config));
+		disable_config.verify_enabled = 0;
+		disable_config.tx_enabled = 0;
+		disable_config.pmac_enabled = 0;
+		disable_config.verify_time = config.verify_time;
+		disable_config.tx_min_frag_size = config.tx_min_frag_size;
+
+		ret = ethtool_mm_set_config(ifname, &disable_config);
+		if (ret < 0) {
+			log_warnx("ethtool-mm", "failed to disable preemption on %s", 
+				  ifname);
+			return -1;
+		}
+
+		/* Small delay to ensure clean state transition */
+		usleep(100000); /* 100ms */
+
+		/* Step 3: Re-enable with saved configuration */
+		log_debug("ethtool-mm", "re-enabling preemption on %s", ifname);
+		config.verify_enabled = 1;
+		config.tx_enabled = 1;
+		config.pmac_enabled = 1;
+
+		ret = ethtool_mm_set_config(ifname, &config);
+		if (ret < 0) {
+			log_warnx("ethtool-mm", "failed to enable preemption on %s", 
+				  ifname);
+			return -1;
+		}
+
+		log_info("ethtool-mm", "preemption enabled on %s", ifname);
+	} else {
+		/* Simply disable */
+		log_debug("ethtool-mm", "disabling preemption on %s", ifname);
+		memset(&disable_config, 0, sizeof(disable_config));
+		disable_config.verify_enabled = 0;
+		disable_config.tx_enabled = 0;
+		disable_config.pmac_enabled = 0;
+
+		ret = ethtool_mm_set_config(ifname, &disable_config);
+		if (ret < 0) {
+			log_warnx("ethtool-mm", "failed to disable preemption on %s", 
+				  ifname);
+			return -1;
+		}
+
+		log_info("ethtool-mm", "preemption disabled on %s", ifname);
+	}
+
+	return 0;
+}
+
