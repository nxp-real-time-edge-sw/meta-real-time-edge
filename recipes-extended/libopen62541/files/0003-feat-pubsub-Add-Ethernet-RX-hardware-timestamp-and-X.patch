From a1b2c3d4e5f600000000000000000000deadbeef Mon Sep 17 00:00:00 2001
From: Minghuan Lian <minghuan.lian@nxp.com>
Date: Thu, 4 Jun 2026 12:04:40 +0900
Subject: [PATCH] feat(pubsub): Add Ethernet RX hardware timestamp and XDP build
 options

Declare the Ethernet RX hardware timestamp PubSub build option in the
top-level CMakeLists.txt, and capture the Ethernet RX hardware timestamp
via SO_TIMESTAMPING in the ethernet PubSub transport plugin.

The XDP accelerated receive path is the upstream LIBBPF_EBPF code. Its
header gate is updated from <bpf/xsk.h> to <xdp/xsk.h> because libbpf
>= 1.0 dropped the AF_XDP socket helpers; they now live in libxdp. The
removed libbpf calls bpf_set_link_xdp_fd()/bpf_get_link_xdp_id() are
migrated to bpf_xdp_detach()/bpf_xdp_query_id(), and libxdp is linked
in CMakeLists.txt so the LIBBPF_EBPF path resolves its symbols.

Upstream-Status: Pending

diff --git a/CMakeLists.txt b/CMakeLists.txt
index cf4c4fd65..6ab7b6321 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -371,6 +371,12 @@ mark_as_advanced(UA_ENABLE_PUBSUB_BUFMALLOC)
 
 #RT and Transport PubSub settings
 option(UA_ENABLE_PUBSUB_ETH_UADP "Enable publish/subscribe UADP over Ethernet" OFF)
+mark_as_advanced(UA_ENABLE_PUBSUB_ETH_UADP)
+option(UA_ENABLE_PUBSUB_ETH_RX_HW_TIMESTAMP "Enable getting Rx HW timestamp on Ethernet packet" OFF)
+mark_as_advanced(UA_ENABLE_PUBSUB_ETH_RX_HW_TIMESTAMP)
+if(UA_ENABLE_PUBSUB_ETH_RX_HW_TIMESTAMP)
+    add_definitions(-DUA_ENABLE_PUBSUB_ETH_RX_HW_TIMESTAMP)
+endif()
 
 if(UA_ENABLE_PUBSUB_ETH_UADP)
     if(NOT CMAKE_SYSTEM MATCHES "Linux")
@@ -1110,6 +1120,15 @@ if(UA_ENABLE_PUBSUB)
         else()
             message("bpf library not found. XDP functionalities will not be available.")
         endif()
+        # The AF_XDP socket helpers (xsk_socket__create, umem rings) live in
+        # libxdp since libbpf >= 1.0 (libbpf dropped bpf/xsk.h). Link libxdp so
+        # the LIBBPF_EBPF accelerated receive path can resolve its symbols.
+        find_library(LIB_XDP xdp)
+        if(LIB_XDP)
+            list(APPEND open62541_LIBRARIES xdp)
+        else()
+            message("xdp library not found. XDP functionalities will not be available.")
+        endif()
     endif()
     if(UA_ENABLE_PUBSUB_MQTT)
         if(WIN32)
diff --git a/plugins/include/open62541/plugin/pubsub_ethernet.h b/plugins/include/open62541/plugin/pubsub_ethernet.h
index 0c87705a0..43c075b27 100644
--- a/plugins/include/open62541/plugin/pubsub_ethernet.h
+++ b/plugins/include/open62541/plugin/pubsub_ethernet.h
@@ -24,6 +24,10 @@ typedef struct {
     UA_UInt64  transmission_time;
 } UA_EthernetWriterGroupTransportDataType;
 
+#ifdef UA_ENABLE_PUBSUB_ETH_RX_HW_TIMESTAMP
+UA_EXPORT extern UA_UInt64 rxHwTimestamp;
+#endif
+
 UA_PubSubTransportLayer UA_EXPORT
 UA_PubSubTransportLayerEthernet(void);
 
diff --git a/plugins/ua_pubsub_ethernet.c b/plugins/ua_pubsub_ethernet.c
index 0f1889550..d136244f3 100644
--- a/plugins/ua_pubsub_ethernet.c
+++ b/plugins/ua_pubsub_ethernet.c
@@ -43,7 +43,7 @@ static UA_THREAD_LOCAL UA_Byte ReceiveMsgBufferETH[RECEIVE_MSG_BUFFER_SIZE];
 #include <linux/if_link.h>
 
 #if defined __has_include
-#   if __has_include(<bpf/bpf.h>) && __has_include(<bpf/libbpf.h>) && __has_include(<bpf/xsk.h>)
+#   if __has_include(<bpf/bpf.h>) && __has_include(<bpf/libbpf.h>) && __has_include(<xdp/xsk.h>)
 #       define LIBBPF_EBPF
         /* Libbpf headers */
 #       include <bpf/bpf.h>
@@ -51,7 +51,7 @@ static UA_THREAD_LOCAL UA_Byte ReceiveMsgBufferETH[RECEIVE_MSG_BUFFER_SIZE];
 #       ifndef asm
 #           define asm __asm__
 #       endif
-#       include <bpf/xsk.h>
+#       include <xdp/xsk.h>
 #   endif
 #endif
 #endif
@@ -163,6 +163,10 @@ enum txtime_flags {
                              SOF_TXTIME_FLAGS_LAST
 };
 
+#ifdef UA_ENABLE_PUBSUB_ETH_RX_HW_TIMESTAMP
+UA_UInt64 rxHwTimestamp;
+#endif
+
 /*
  * OPC-UA specification Part 14:
  *
@@ -292,7 +296,7 @@ static xdpsock *xsk_configure(xdp_umem *umem, UA_UInt32 hw_receive_queue,
 
     if (!xdp_socket->umem) {
         UA_close(xsk_socket__fd(xdp_socket->xskfd));
-        bpf_set_link_xdp_fd(ifindex, -1, xdp_flags);
+        bpf_xdp_detach(ifindex, xdp_flags, NULL);
         UA_free(xskparam);
         UA_free(xdp_socket);
         return NULL;
@@ -335,13 +339,13 @@ static xdpsock *xsk_configure(xdp_umem *umem, UA_UInt32 hw_receive_queue,
         (void)xsk_umem__delete(xdp_socket->umem->umem);
         UA_free(xdp_socket->umem);
         UA_close(xsk_socket__fd(xdp_socket->xskfd));
-        bpf_set_link_xdp_fd(ifindex, -1, xdp_flags);
+        bpf_xdp_detach(ifindex, xdp_flags, NULL);
         UA_free(xskparam);
         UA_free(xdp_socket);
         return NULL;
     }
 
-    ret = bpf_get_link_xdp_id(ifindex, &xdp_socket->bpf_prog_id, xdp_flags);
+    ret = bpf_xdp_query_id(ifindex, xdp_flags, &xdp_socket->bpf_prog_id);
     if (ret) {
         UA_LOG_ERROR (UA_Log_Stdout, UA_LOGCATEGORY_SERVER,
             "PubSub Connection creation failed. Unable to retrieve XDP program.");
@@ -349,7 +353,7 @@ static xdpsock *xsk_configure(xdp_umem *umem, UA_UInt32 hw_receive_queue,
         (void)xsk_umem__delete(xdp_socket->umem->umem);
         UA_free(xdp_socket->umem);
         UA_close(xsk_socket__fd(xdp_socket->xskfd));
-        bpf_set_link_xdp_fd(ifindex, -1, xdp_flags);
+        bpf_xdp_detach(ifindex, xdp_flags, NULL);
         UA_free(xskparam);
         UA_free(xdp_socket);
         return NULL;
@@ -378,8 +382,7 @@ UA_PubSubChannelEthernetXDP_open(UA_PubSubChannelDataEthernet *channelDataEthern
                                                    sockOptions->xdp_bind_flags);
     if(!channelDataEthernet->xdpsocket) {
         UA_LOG_ERROR(UA_Log_Stdout, UA_LOGCATEGORY_SERVER, "XDP Socket configuration failed");
-        bpf_set_link_xdp_fd(channelDataEthernet->ifindex, -1,
-                            sockOptions->xdp_flags);
+        bpf_xdp_detach(channelDataEthernet->ifindex, sockOptions->xdp_flags, NULL);
         return UA_STATUSCODE_BADINTERNALERROR;
     }
 
@@ -1131,6 +1134,14 @@ UA_PubSubChannelEthernet_receive(UA_PubSubChannel *channel,
     UA_Int32        receiveFlags;
     UA_StatusCode   retval = UA_STATUSCODE_GOOD;
     UA_UInt16       rcvCount = 0;
+#ifdef UA_ENABLE_PUBSUB_ETH_RX_HW_TIMESTAMP
+    union {
+        struct cmsghdr cm;
+        char buf[512];
+    } u;
+    struct cmsghdr *cmsg;
+    struct timespec *ts = NULL;
+#endif
 
     memset(&tmptv, 0, sizeof(tmptv));
 
@@ -1200,6 +1211,10 @@ UA_PubSubChannelEthernet_receive(UA_PubSubChannel *channel,
         iov[1].iov_len  = RECEIVE_MSG_BUFFER_SIZE;
         msg.msg_iov     = iov;
         msg.msg_iovlen  = 2;
+#ifdef UA_ENABLE_PUBSUB_ETH_RX_HW_TIMESTAMP
+        msg.msg_control = u.buf;
+        msg.msg_controllen = sizeof(u.buf);
+#endif
 
         dataLen = UA_recvmsg(channel->sockfd, &msg, receiveFlags);
         if(dataLen < 0) {
@@ -1224,6 +1239,23 @@ UA_PubSubChannelEthernet_receive(UA_PubSubChannel *channel,
             retval = UA_STATUSCODE_GOODNODATA;
             break;
         }
+
+#ifdef UA_ENABLE_PUBSUB_ETH_RX_HW_TIMESTAMP
+        rxHwTimestamp = 0;
+        for (cmsg = CMSG_FIRSTHDR(&msg); cmsg != NULL; cmsg = CMSG_NXTHDR(&msg, cmsg)) {
+            if (cmsg->cmsg_level == SOL_SOCKET && cmsg->cmsg_type == SO_TIMESTAMPING) {
+                if (cmsg->cmsg_len < sizeof(*ts) * 3) {
+                    UA_LOG_ERROR(UA_Log_Stdout, UA_LOGCATEGORY_SERVER,
+                                 "short SO_TIMESTAMPING message!\n");
+                } else {
+                    ts = (struct timespec *)CMSG_DATA(cmsg);
+                    rxHwTimestamp = (UA_UInt64)(ts[2].tv_sec * 1000000000 + ts[2].tv_nsec);
+                }
+                break;
+            }
+        }
+#endif
+
         /* Make sure we match our target */
         if(memcmp(eth_hdr.ether_dhost, channelDataEthernet->targetAddress, ETH_ALEN) != 0) {
             retval = UA_STATUSCODE_GOODNODATA;
@@ -1283,7 +1315,7 @@ UA_PubSubChannelEthernet_close(UA_PubSubChannel *channel) {
         xsk_socket__delete(channelDataEthernet->xdpsocket->xskfd);
         (void)xsk_umem__delete(channelDataEthernet->xdpsocket->umem->umem);
         /* Detach XDP program from the interface */
-        bpf_set_link_xdp_fd(channelDataEthernet->ifindex, -1, channelDataEthernet->xdp_flags);
+        bpf_xdp_detach(channelDataEthernet->ifindex, channelDataEthernet->xdp_flags, NULL);
         UA_free(channelDataEthernet->xdpsocket->umem->buffer);
         UA_free(channelDataEthernet->xdpsocket->umem);
         UA_free(channelDataEthernet->xdpsocket);
--
