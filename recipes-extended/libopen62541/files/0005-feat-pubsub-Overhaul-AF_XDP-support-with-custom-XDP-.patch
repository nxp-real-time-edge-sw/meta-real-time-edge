+    /* Print 16 bytes per line */
+    for(size_t off = 0; off < len; off += 16) {
+        char hexPart[3 * 16 + 1];  /* "XX " x 16 + NUL */
+        char ascPart[16 + 1];
+        size_t hpos = 0;
+        size_t lineEnd = off + 16;
+        if(lineEnd > len)
+            lineEnd = len;
+
+        for(size_t i = off; i < lineEnd; i++) {
+            UA_Byte b = data[i];
+            static const char hexDigits[] = "0123456789abcdef";
+            hexPart[hpos++] = hexDigits[(b >> 4) & 0x0f];
+            hexPart[hpos++] = hexDigits[b & 0x0f];
+            hexPart[hpos++] = ' ';
+            ascPart[i - off] = (b >= 0x20 && b <= 0x7e) ? (char)b : '.';
+        }
+
+        hexPart[hpos] = '\0';
+        ascPart[lineEnd - off] = '\0';
+
+        UA_LOG_INFO(UA_Log_Stdout, UA_LOGCATEGORY_SERVER,
+                    "  %04zx: %-48s  %s", off, hexPart, ascPart);
+    }
