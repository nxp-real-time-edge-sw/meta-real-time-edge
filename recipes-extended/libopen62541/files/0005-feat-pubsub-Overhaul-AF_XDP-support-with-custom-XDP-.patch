+/* Prints packets formatted as 16 bytes per line with both hex and ASCII columns. */
+static void
+dumpPacket(const char *name, const UA_Byte *data, size_t len) {
+    struct timespec currentTime;
+
+#if !defined(UA_ARCHITECTURE_POSIX)
