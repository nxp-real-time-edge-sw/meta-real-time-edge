+/**
+ * Load a custom BPF object file, attach its first XDP program to the
+ * interface, locate the XSKMAP named "xsks_map" and insert the AF_XDP
+ * socket fd at the given queue index.
+ *
+ * On success the loaded bpf_object and the XSKMAP fd are stored in
+ * channelDataEthernet so they can be cleaned up on close.
+ *
+ * @return UA_STATUSCODE_GOOD on success.
+ */
+static UA_StatusCode
+xdp_load_custom_prog(UA_PubSubChannelDataEthernet *channelDataEthernet,
+                     const char *progPath,
+                     UA_UInt32 hw_receive_queue) {
+    struct bpf_object *obj = NULL;
+    struct bpf_program *prog = NULL;
+    struct bpf_map *map = NULL;
+    int prog_fd, map_fd, xsk_fd, ret;
+
+    obj = bpf_object__open_file(progPath, NULL);
+    if (!obj) {
+        UA_LOG_ERROR(UA_Log_Stdout, UA_LOGCATEGORY_SERVER,
+                     "PubSub XDP: failed to open BPF object '%s': %s",
+                     progPath, strerror(errno));
+        return UA_STATUSCODE_BADINTERNALERROR;
+    }
+
+    ret = bpf_object__load(obj);
+    if (ret) {
+        UA_LOG_ERROR(UA_Log_Stdout, UA_LOGCATEGORY_SERVER,
+                     "PubSub XDP: failed to load BPF object '%s': %s",
+                     progPath, strerror(errno));
+        bpf_object__close(obj);
+        return UA_STATUSCODE_BADINTERNALERROR;
+    }
+
+    /* Use the first program in the object */
+    prog = bpf_object__next_program(obj, NULL);
+    if (!prog) {
+        UA_LOG_ERROR(UA_Log_Stdout, UA_LOGCATEGORY_SERVER,
+                     "PubSub XDP: no program found in BPF object '%s'",
+                     progPath);
+        bpf_object__close(obj);
+        return UA_STATUSCODE_BADINTERNALERROR;
+    }
+
+    prog_fd = bpf_program__fd(prog);
+    if (prog_fd < 0) {
+        UA_LOG_ERROR(UA_Log_Stdout, UA_LOGCATEGORY_SERVER,
+                     "PubSub XDP: invalid program fd in '%s'", progPath);
+        bpf_object__close(obj);
+        return UA_STATUSCODE_BADINTERNALERROR;
+    }
+
+    /* Attach XDP program to the interface */
+    ret = bpf_xdp_attach(channelDataEthernet->ifindex, prog_fd,
+                          channelDataEthernet->xdp_flags, NULL);
+    if (ret) {
+        UA_LOG_ERROR(UA_Log_Stdout, UA_LOGCATEGORY_SERVER,
+                     "PubSub XDP: bpf_xdp_attach failed for ifindex %d: %s",
+                     channelDataEthernet->ifindex, strerror(-ret));
+        bpf_object__close(obj);
+        return UA_STATUSCODE_BADINTERNALERROR;
+    }
+
+    /* Locate the XSKMAP (expected name: "xsks_map") */
+    map = bpf_object__find_map_by_name(obj, "xsks_map");
+    if (!map) {
+        UA_LOG_ERROR(UA_Log_Stdout, UA_LOGCATEGORY_SERVER,
+                     "PubSub XDP: map 'xsks_map' not found in '%s'",
+                     progPath);
+        bpf_xdp_detach(channelDataEthernet->ifindex,
+                        channelDataEthernet->xdp_flags, NULL);
+        bpf_object__close(obj);
+        return UA_STATUSCODE_BADINTERNALERROR;
+    }
+
+    map_fd = bpf_map__fd(map);
+    if (map_fd < 0) {
