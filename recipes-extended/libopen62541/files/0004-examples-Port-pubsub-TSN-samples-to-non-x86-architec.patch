From b2c3d4e5f60718290000000000000000cafebabe Mon Sep 17 00:00:00 2001
From: Minghuan Lian <minghuan.lian@nxp.com>
Date: Thu, 4 Jun 2026 12:04:55 +0900
Subject: [PATCH] examples: Port pubsub TSN samples to non-x86 architectures

The pubsub_TSN_* sample applications unconditionally include <sys/io.h>,
which provides the x86-only port I/O helpers (inb/outb) and does not
exist on architectures such as aarch64. Guard the include so the TSN
samples build on non-x86 targets.

Upstream-Status: Pending

diff --git a/examples/pubsub_realtime/pubsub_TSN_loopback.c b/examples/pubsub_realtime/pubsub_TSN_loopback.c
index 803a3c107..318f707c5 100644
--- a/examples/pubsub_realtime/pubsub_TSN_loopback.c
+++ b/examples/pubsub_realtime/pubsub_TSN_loopback.c
@@ -77,7 +77,12 @@
 #include <stdio.h>
 #include <stdlib.h>
 #include <linux/types.h>
+/* <sys/io.h> provides x86 port I/O helpers (inb/outb) and only exists on
+ * x86/x86_64 glibc. It is not used by this example, so guard it to keep the
+ * sample buildable on architectures such as aarch64. */
+#if defined(__i386__) || defined(__x86_64__)
 #include <sys/io.h>
+#endif
 #include <getopt.h>
 
 /* For thread operations */
diff --git a/examples/pubsub_realtime/pubsub_TSN_loopback_single_thread.c b/examples/pubsub_realtime/pubsub_TSN_loopback_single_thread.c
index 7db37e9d5..1f86146b6 100644
--- a/examples/pubsub_realtime/pubsub_TSN_loopback_single_thread.c
+++ b/examples/pubsub_realtime/pubsub_TSN_loopback_single_thread.c
