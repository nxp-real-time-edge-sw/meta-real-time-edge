From 0cfe8ceaaf72226e8f49762957f6ac13a58560ca Mon Sep 17 00:00:00 2001
From: Marouen Ghodhbane <marouen.ghodhbane@nxp.com>
Date: Thu, 9 Nov 2023 10:24:15 +0100
Subject: [PATCH 1/5] configure: properly quote the toolchain tools variables
 before the check

Bitbake will declare toolchain tools variables with multiple options: use double quote
to avoid the following error with $CC for example:

*** ERROR: Cannot find tool -march=armv8-a+crc+crypto

Signed-off-by: Marouen Ghodhbane <marouen.ghodhbane@nxp.com>

Upstream-Status: Pending
---
 configure | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/configure b/configure
index f363ef6..830ebb1 100755
--- a/configure
+++ b/configure
@@ -70,7 +70,7 @@ check_toolchain()
 
     CLANG=$(find_tool clang "$CLANG")
 
-    for TOOL in $PKG_CONFIG $CC $OBJCOPY $CLANG $M4 $READELF; do
+    for TOOL in "$PKG_CONFIG" "$CC" "$OBJCOPY" "$CLANG" "$M4" "$READELF"; do
         if [ ! $(command -v ${TOOL} 2>/dev/null) ]; then
             echo "*** ERROR: Cannot find tool ${TOOL}" ;
             exit 1;
-- 
