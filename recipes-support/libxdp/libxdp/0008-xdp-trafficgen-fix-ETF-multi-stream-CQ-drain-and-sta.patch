@@ -1579,6 +1627,18 @@ static int tx_only(struct xsk_ctx *ctx, struct xsk_socket_info *xsk, __u32 *fram
  * ============================================================
  */
 
+#define BACKOFF_INIT_US		10
+#define BACKOFF_MAX_US		100000
+
+static inline void backoff_sleep(unsigned int *backoff_us)
+{
+	usleep(*backoff_us);
+	if (*backoff_us < BACKOFF_MAX_US)
+		*backoff_us *= 2;
+	if (*backoff_us > BACKOFF_MAX_US)
+		*backoff_us = BACKOFF_MAX_US;
+}
+
 static void etf_tx_only(struct xsk_ctx *ctx, struct etf_stream_ctx *stream,
 			struct xsk_socket_info *xsk, unsigned long tx_ns)
 {
@@ -1589,11 +1649,20 @@ static void etf_tx_only(struct xsk_ctx *ctx, struct etf_stream_ctx *stream,
 	void *frame_ptr;
 	void *pkt_ptr;
 	__u32 idx;
+	unsigned int reserve_backoff_us = BACKOFF_INIT_US;
+	unsigned int frame_backoff_us = BACKOFF_INIT_US;
 
 	while (xsk_ring_prod__reserve(&xsk->tx, 1, &idx) < 1) {
-		kick_tx(xsk);
+		if (ctx->opt.no_need_wakeup ||
+		    xsk_ring_prod__needs_wakeup(&xsk->tx)) {
+			if (kick_tx(xsk)) {
+				*ctx->shared_done = true;
+				return;
+			}
+		}
 		if (*ctx->shared_done)
 			return;
+		backoff_sleep(&reserve_backoff_us);
 	}
 
 	tx_desc = xsk_ring_prod__tx_desc(&xsk->tx, idx);
@@ -1601,12 +1670,23 @@ static void etf_tx_only(struct xsk_ctx *ctx, struct etf_stream_ctx *stream,
 
 	/* Get a free frame from per-stream SPSC ring (parent refills via CQ) */
 	while (etf_stream_free_pop(stream, &frame_offset) != 0) {
-		kick_tx(xsk);
+		if (ctx->opt.no_need_wakeup ||
+		    xsk_ring_prod__needs_wakeup(&xsk->tx)) {
+			if (kick_tx(xsk)) {
+				*ctx->shared_done = true;
+				xsk->tx.cached_prod--;
+				return;
+			}
+		}
+
+		try_drain_shared_cq(ctx, xsk, stream);
+
 		if (*ctx->shared_done) {
 			/* Undo the TX ring reservation */
 			xsk->tx.cached_prod--;
 			return;
 		}
+		backoff_sleep(&frame_backoff_us);
 	}
 
 	frame_ptr = xsk_umem__get_data(xsk->umem->buffer, frame_offset);
@@ -1640,7 +1720,16 @@ static void etf_tx_only(struct xsk_ctx *ctx, struct etf_stream_ctx *stream,
 	stream->tx_frags++;
 
 	/* Kick TX so kernel processes the descriptor */
-	kick_tx(xsk);
+	if (ctx->opt.no_need_wakeup ||
+	    xsk_ring_prod__needs_wakeup(&xsk->tx)) {
+		if (kick_tx(xsk)) {
+			*ctx->shared_done = true;
+			return;
+		}
+	}
+
+	if (xsk->outstanding_tx >= CQ_DRAIN_THRESHOLD)
+		try_drain_shared_cq(ctx, xsk, stream);
 }
 
 static void child_signal_handler(int sig)
@@ -1652,13 +1741,15 @@ static void child_signal_handler(int sig)
 static void xsk_tx_only_child(struct etf_stream_ctx *stream,
 			     struct xsk_ctx *ctx)
 {
-	unsigned long tx_cycle_base_ns = 0;
+	unsigned long tx_cycle_base_ns;
 	unsigned long hw_tx_time_ns = 0;
 	unsigned long sw_tx_time_ns = 0;
 
-	/* Align Tx time to one cycle boundary */
-	tx_cycle_base_ns = (get_nsecs(ctx->opt.clock) / stream->tx_cycle_ns)
-		* stream->tx_cycle_ns + TIME_US_TO_NS(10000);
+	/*
+	 * Use the common start time computed by the parent so that all
+	 * streams begin transmitting on the same aligned cycle boundary.
+	 */
+	tx_cycle_base_ns = stream->tx_cycle_base_ns;
 
 	while (child_running && !*ctx->shared_done) {
 		unsigned long now = 0;
@@ -1695,56 +1786,80 @@ static void xsk_tx_only_child(struct etf_stream_ctx *stream,
 
 		tx_cycle_base_ns += stream->tx_cycle_ns;
 	}
+
+	/* Wait until the NIC has passed the launch time of the last packet */
+	if (hw_tx_time_ns) {
+		do {
+			usleep(100000);
+		} while (get_nsecs(ctx->opt.clock) < hw_tx_time_ns + TIME_US_TO_NS(100000));
+	}
 }
 
-static int parse_stream_config(const char *path, struct stream_cfg *cfgs,
-			       int max_count)
+/*
+ * Child process entry point for a single ETF stream.
+ * Sets up signal handling, scheduler priority, and runs the TX loop
+ * before cleaning up and exiting.  Never returns.
+ */
+static void __attribute__((noreturn)) run_stream_child(struct etf_stream_ctx *stream,
+					struct xsk_ctx *ctx, int stream_idx)
 {
-	char line[MAX_LINE_LENGTH];
-	FILE *fp;
-	int count = 0;
-
-	fp = fopen(path, "r");
-	if (!fp) {
-		pr_warn("Failed to open XDP ETF stream config file: %s\n",
-			strerror(errno));
-		return -errno;
-	}
+	struct sigaction sa;
+	sigset_t unblock;
 
-	while (fgets(line, sizeof(line), fp)) {
-		char *comment;
+	/* Install signal handler for clean shutdown */
+	memset(&sa, 0, sizeof(sa));
+	sa.sa_handler = child_signal_handler;
+	sigaction(SIGTERM, &sa, NULL);
+	sigaction(SIGINT, &sa, NULL);
 
-		comment = strchr(line, '#');
-		if (comment)
-			*comment = '\0';
+	/* Unblock signals that parent blocked for signalfd */
+	sigemptyset(&unblock);
+	sigaddset(&unblock, SIGTERM);
+	sigaddset(&unblock, SIGINT);
+	sigaddset(&unblock, SIGQUIT);
+	sigprocmask(SIG_UNBLOCK, &unblock, NULL);
 
-		if (count >= max_count) {
-			pr_warn("Too many streams (max %d)\n", max_count);
-			break;
-		}
+	/* Lock all pages in child process */
+	mlockall(MCL_CURRENT | MCL_FUTURE);
 
-		if (sscanf(line, "%lu %u %u %u",
-			   &cfgs[count].index,
-			   &cfgs[count].cycle_us,
-			   &cfgs[count].offset_us,
-			   &cfgs[count].preload_us) == 4)
-			count++;
-	}
+	/* Set scheduler priority */
+	xsk_set_sched_priority(ctx->opt.sched_policy, ctx->opt.sched_prio);
 
-	fclose(fp);
-	return count;
+	/*
+	 * Use the pre-created socket for this stream.
+	 * The child inherits the fd from fork().
+	 * Point ctx->xsks[0] to this stream's socket.
+	 */
+	ctx->xsks[0] = ctx->stream_xsks[stream_idx];
+	ctx->num_socks = 1;
+
+	/* Run TX loop */
+	xsk_tx_only_child(stream, ctx);
+
+	/*
+	 * Cleanup: close our copy of the socket fd explicitly, then
+	 * _exit().  Do NOT call xsk_socket__delete() -- it tries to
+	 * detach XDP programs and manipulate libxdp refcounts, which
+	 * would corrupt parent state.
+	 *
+	 * Close the socket fd for this stream's socket so the kernel
+	 * releases resources promptly.  _exit() closes remaining
+	 * inherited fds (anchor socket, other stream sockets, signalfd).
+	 */
+	close(xsk_socket__fd(ctx->stream_xsks[stream_idx]->xsk));
+	_exit(0);
 }
 
