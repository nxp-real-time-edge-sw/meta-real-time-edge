@@ -864,8 +909,11 @@ void xsk_ctx__destroy(struct xsk_ctx *ctx)
 	if (ctx->shared_done && ctx->shared_done != MAP_FAILED)
 		munmap((void *)ctx->shared_done, sizeof(bool));
 
+	if (ctx->cq_drain_lock && ctx->cq_drain_lock != MAP_FAILED)
+		munmap((void *)ctx->cq_drain_lock, sizeof(_Atomic int));
+
 	close(ctx->signal_fd);
-	munmap(ctx->bufs, NUM_FRAMES * ctx->opt.frame_size);
+	munmap(ctx->bufs, ctx->num_frames * ctx->opt.frame_size);
 	free(ctx);
 }
 
