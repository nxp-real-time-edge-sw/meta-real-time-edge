+static int parse_stream_config(const char *path, struct stream_cfg *cfgs,
+			       int max_count)
+{
+	char line[MAX_LINE_LENGTH];
+	FILE *fp;
+	int count = 0;
+
+	fp = fopen(path, "r");
+	if (!fp) {
+		pr_warn("Failed to open XDP ETF stream config file: %s\n",
+			strerror(errno));
+		return -errno;
+	}
+
+	while (fgets(line, sizeof(line), fp)) {
+		char *comment;
+
+		comment = strchr(line, '#');
+		if (comment)
+			*comment = '\0';
+
+		if (count >= max_count) {
+			pr_warn("Too many streams (max %d)\n", max_count);
+			break;
+		}
+
+		if (sscanf(line, "%lu %u %u %u",
+			   &cfgs[count].index,
+			   &cfgs[count].cycle_us,
+			   &cfgs[count].offset_us,
+			   &cfgs[count].preload_us) == 4) {
+			if (cfgs[count].index >= MAX_STREAM_COUNT) {
+				pr_warn("Stream %d: index %lu exceeds max %d\n",
+					count, cfgs[count].index,
+					MAX_STREAM_COUNT - 1);
+				fclose(fp);
+				return -EINVAL;
+			}
+			for (int i = 0; i < count; i++) {
+				if (cfgs[i].index == cfgs[count].index) {
+					pr_warn("Stream %d: duplicate index %lu (same as stream %d)\n",
+						count, cfgs[count].index, i);
+					fclose(fp);
+					return -EINVAL;
+				}
+			}
+			if (cfgs[count].cycle_us < MIN_CYCLE_US ||
+			    cfgs[count].cycle_us > MAX_CYCLE_US) {
+				pr_warn("Stream %d: cycle_us %u out of range [%u, %u]\n",
+					count, cfgs[count].cycle_us,
+					MIN_CYCLE_US, MAX_CYCLE_US);
+				fclose(fp);
+				return -EINVAL;
+			}
+			if (cfgs[count].offset_us > cfgs[count].cycle_us) {
+				pr_warn("Stream %d: offset_us %u exceeds cycle_us %u\n",
+					count, cfgs[count].offset_us,
