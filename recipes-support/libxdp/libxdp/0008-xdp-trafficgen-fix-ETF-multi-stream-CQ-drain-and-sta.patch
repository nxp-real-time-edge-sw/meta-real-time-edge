 	if (ctx->benchmark_done && ctx->shared_done)
 		*ctx->shared_done = true;
 
@@ -686,24 +682,38 @@ static inline int etf_stream_free_pop(struct etf_stream_ctx *s, __u64 *addr)
  * frames back to the owning stream's per-stream free ring.
  * Frame ownership is determined by address range (static partitioning).
  *
- * Thread safety: this function is only called from the parent's
- * single-threaded xsk_stats_poller() loop.  Children never touch
- * the CQ — they only produce to their own TX rings and consume
- * from their per-stream SPSC free rings.  The CQ is single-consumer
- * by AF_XDP design, and the parent is the sole consumer.
+ * Thread safety: callers must serialise access via ctx->cq_drain_lock
+ * (atomic trylock).  Both the parent (stats-poller) and children
+ * (spin-waiting for free frames) may call try_drain_shared_cq().
+ * The CQ is single-consumer by AF_XDP design; the trylock ensures
+ * only one process touches it at any time.
  */
-static void drain_shared_cq(struct xsk_ctx *ctx)
+static void drain_shared_cq(struct xsk_ctx *ctx,
+			    struct xsk_socket_info *caller_xsk,
+			    struct etf_stream_ctx *caller_stream)
 {
 	struct xsk_umem_info *umem = ctx->umem;
-	__u32 frames_per_stream;
 	unsigned int rcvd;
 	__u32 idx = 0;
 	unsigned int i;
+	unsigned int caller_reclaimed = 0;
 
 	if (!umem || !umem->umem || ctx->stream_idx <= 0)
 		return;
 
-	frames_per_stream = NUM_FRAMES / ctx->stream_idx;
+	/*
+	 * Re-sync the consumer ring cache from shared pointers.
+	 * After fork(), each process keeps its own cached_cons/cached_prod
+	 * (heap memory, COW-private), while *consumer / *producer live in
+	 * shared mmap'd pages updated by the kernel and whichever process
+	 * last drained.  Without this resync a child could re-process
+	 * completions already consumed by another process, double-pushing
+	 * frames into per-stream free rings and corrupting the CQ state.
+	 */
+	umem->cq.cached_prod = __atomic_load_n(umem->cq.producer,
+					       __ATOMIC_ACQUIRE);
+	umem->cq.cached_cons = __atomic_load_n(umem->cq.consumer,
+					       __ATOMIC_ACQUIRE);
 
 	rcvd = xsk_ring_cons__peek(&umem->cq, 64, &idx);
 	if (!rcvd)
@@ -719,14 +729,49 @@ static void drain_shared_cq(struct xsk_ctx *ctx)
 
 		/* Determine owning stream by frame index range */
 		frame_idx = addr / ctx->opt.frame_size;
-		sid = frame_idx / frames_per_stream;
+		sid = frame_idx / FRAMES_PER_STREAM;
+
+		if (sid < 0 || sid >= ctx->stream_idx) {
+			pr_warn("CQ drain: unexpected sid %d for addr 0x%llx\n",
+				sid, (unsigned long long)addr);
+			continue;
+		}
 
 		if (etf_stream_free_push(ctx->streams[sid], addr))
 			pr_warn("CQ drain: stream %d free ring full, frame 0x%llx lost\n",
 				sid, (unsigned long long)addr);
+
+		/* Track completions belonging to the calling child */
+		if (caller_stream && ctx->streams[sid] == caller_stream)
+			caller_reclaimed++;
 	}
 
 	xsk_ring_cons__release(&umem->cq, rcvd);
+
+	/* Update the caller's outstanding_tx counter */
+	if (caller_xsk && caller_reclaimed)
+		caller_xsk->outstanding_tx -= caller_reclaimed;
+}
+
+/*
+ * Atomic-trylock wrapper around drain_shared_cq().
+ * Returns immediately if another process already holds the lock.
+ */
+static void try_drain_shared_cq(struct xsk_ctx *ctx,
+				struct xsk_socket_info *caller_xsk,
+				struct etf_stream_ctx *caller_stream)
+{
+	int expected = 0;
+
+	if (!atomic_compare_exchange_strong_explicit(ctx->cq_drain_lock,
+						     &expected, 1,
+						     memory_order_acquire,
+						     memory_order_relaxed))
+		return; /* someone else is draining */
+
+	drain_shared_cq(ctx, caller_xsk, caller_stream);
+
+	atomic_store_explicit(ctx->cq_drain_lock, 0, memory_order_release);
 }
 
 int xsk_stats_poller(struct xsk_ctx *ctx)
