+			    cfgs[count].preload_us > MAX_PRELOAD_US) {
+				pr_warn("Stream %d: preload_us %u out of range [%u, %u]\n",
+					count, cfgs[count].preload_us,
+					MIN_PRELOAD_US, MAX_PRELOAD_US);
+				fclose(fp);
+				return -EINVAL;
+			}
