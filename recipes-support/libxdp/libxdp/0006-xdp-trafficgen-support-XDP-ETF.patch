+/*
+ * ============================================================
+ * XDP ETF (Earliest TxTime First) support
+ * ============================================================
+ */
+
+static void etf_tx_only(struct xsk_ctx *ctx, struct etf_stream_ctx *stream,
+			struct xsk_socket_info *xsk, unsigned long tx_ns)
+{
+	struct xsk_tx_metadata *meta;
+	struct xdp_desc *tx_desc;
+	struct etf_pktgen_hdr *pktgen_hdr;
+	__u64 frame_offset;
+	void *frame_ptr;
+	void *pkt_ptr;
+	__u32 idx;
+
+	while (xsk_ring_prod__reserve(&xsk->tx, 1, &idx) < 1) {
+		kick_tx(xsk);
+		if (*ctx->shared_done)
+			return;
+	}
+
+	tx_desc = xsk_ring_prod__tx_desc(&xsk->tx, idx);
+	memset(tx_desc, 0, sizeof(struct xdp_desc));
+
+	/* Get a free frame from per-stream SPSC ring (parent refills via CQ) */
+	while (etf_stream_free_pop(stream, &frame_offset) != 0) {
+		kick_tx(xsk);
+		if (*ctx->shared_done) {
+			/* Undo the TX ring reservation */
+			xsk->tx.cached_prod--;
+			return;
+		}
+	}
+
+	frame_ptr = xsk_umem__get_data(xsk->umem->buffer, frame_offset);
+
+	meta = frame_ptr;
+	memset(meta, 0, TX_METADATA_SIZE);
+	meta->flags = XDP_TXMD_FLAGS_LAUNCH_TIME;
+	meta->request.launch_time = tx_ns;
+
+	pkt_ptr = frame_ptr + TX_METADATA_SIZE;
+	memcpy(pkt_ptr, ctx->pkt_data, PKT_SIZE(&ctx->opt));
+
+	struct ethhdr *eth_hdr = pkt_ptr;
+	eth_hdr->h_dest[5] = stream->index & 0x0ff;
+
+	pktgen_hdr = (struct etf_pktgen_hdr *)(pkt_ptr + PKTGEN_HDR_OFFSET(&ctx->opt));
+	pktgen_hdr->seq_num = htonl(stream->sequence++);
+
+	if (ctx->opt.timestamp) {
+		pktgen_hdr->app_tx_time = htonl(get_nsecs(ctx->opt.clock) % NSEC_PER_SEC);
+		pktgen_hdr->hw_tx_time = htonl(tx_ns % NSEC_PER_SEC);
+	}
+
+	tx_desc->addr = (__u64)(frame_offset + TX_METADATA_SIZE);
+	tx_desc->len = PKT_SIZE(&ctx->opt);
+	tx_desc->options = XDP_TX_METADATA;
+
+	xsk_ring_prod__submit(&xsk->tx, 1);
+	xsk->outstanding_tx++;
+	stream->tx_npkts++;
+	stream->tx_frags++;
+
+	/* Kick TX so kernel processes the descriptor */
+	kick_tx(xsk);
+}
+
+static void child_signal_handler(int sig)
+{
+	(void)sig;
+	child_running = 0;
+}
+
+static void xsk_tx_only_child(struct etf_stream_ctx *stream,
+			     struct xsk_ctx *ctx)
+{
+	unsigned long tx_cycle_base_ns = 0;
+	unsigned long hw_tx_time_ns = 0;
+	unsigned long sw_tx_time_ns = 0;
+
+	/* Align Tx time to one cycle boundary */
+	tx_cycle_base_ns = (get_nsecs(ctx->opt.clock) / stream->tx_cycle_ns)
+		* stream->tx_cycle_ns + TIME_US_TO_NS(10000);
+
+	while (child_running && !*ctx->shared_done) {
+		unsigned long now = 0;
+		struct timespec next;
+		long diff;
+		int err;
+
+		hw_tx_time_ns = tx_cycle_base_ns + stream->tx_offset_time_ns;
+		sw_tx_time_ns = hw_tx_time_ns - stream->tx_preload_time_ns;
+
+		next.tv_sec = sw_tx_time_ns / NSEC_PER_SEC;
+		next.tv_nsec = sw_tx_time_ns % NSEC_PER_SEC;
+
+		err = clock_nanosleep(ctx->opt.clock, TIMER_ABSTIME, &next, NULL);
+		if (err) {
+			if (err != EINTR)
+				pr_warn("clock_nanosleep failed. Err:%d errno:%d\n",
+						err, errno);
+			break;
+		}
+
+		now = get_nsecs(ctx->opt.clock);
+		diff = now - sw_tx_time_ns;
+		if (diff < stream->tx_cycle_diff_min)
+			stream->tx_cycle_diff_min = diff;
+
+		if (diff > stream->tx_cycle_diff_max)
+			stream->tx_cycle_diff_max = diff;
+
+		stream->tx_cycle_diff_ave += (double)diff;
+		stream->tx_cycle_cnt++;
+
+		etf_tx_only(ctx, stream, ctx->xsks[0], hw_tx_time_ns);
+
+		tx_cycle_base_ns += stream->tx_cycle_ns;
+	}
+}
+
+static int parse_stream_config(const char *path, struct stream_cfg *cfgs,
+			       int max_count)
+{
+	char line[MAX_LINE_LENGTH];
+	FILE *fp;
+	int count = 0;
+
+	fp = fopen(path, "r");
+	if (!fp) {
+		pr_warn("Failed to open XDP ETF stream config file: %s\n",
+			strerror(errno));
+		return -errno;
+	}
+
+	while (fgets(line, sizeof(line), fp)) {
+		char *comment;
+
+		comment = strchr(line, '#');
+		if (comment)
+			*comment = '\0';
+
+		if (count >= max_count) {
+			pr_warn("Too many streams (max %d)\n", max_count);
+			break;
+		}
+
+		if (sscanf(line, "%lu %u %u %u",
+			   &cfgs[count].index,
+			   &cfgs[count].cycle_us,
+			   &cfgs[count].offset_us,
+			   &cfgs[count].preload_us) == 4)
+			count++;
+	}
+
+	fclose(fp);
+	return count;
+}
+
+int xsk_tx_streams(struct xsk_ctx *ctx)
+{
+	struct stream_cfg cfgs[MAX_STREAM_COUNT];
+	struct etf_stream_ctx *stream;
+	int num_streams, i;
+	__u32 frames_per_stream;
+	pid_t pid;
+	int ret;
+
+	if (!ctx->opt.etf_streams_config)
+		return -EINVAL;
+
+	if ((__u32)(PKT_SIZE(&ctx->opt) + TX_METADATA_SIZE) > ctx->opt.frame_size) {
+		pr_warn("Packet size %d + metadata %d exceeds frame size %d; "
+			"multi-fragment packets are not supported in ETF mode\n",
+			PKT_SIZE(&ctx->opt), TX_METADATA_SIZE,
+			ctx->opt.frame_size);
+		return -EINVAL;
+	}
+
+	ctx->stream_idx = 0;
+	ctx->num_stream_xsks = 0;
+
+	num_streams = parse_stream_config(ctx->opt.etf_streams_config,
+					  cfgs, MAX_STREAM_COUNT);
+	if (num_streams <= 0)
+		return num_streams ? num_streams : -EINVAL;
+
+	frames_per_stream = NUM_FRAMES / num_streams;
+
+	/*
+	 * Create all per-stream sockets on the shared UMEM BEFORE forking.
+	 * libxdp sees umem->refcount > 0 on the 2nd+ call and automatically
+	 * sets XDP_SHARED_UMEM in bind(), referencing the anchor socket's fd.
+	 * Socket #0 (created in xsk_ctx__create) is the UMEM anchor.
+	 */
+	for (i = 0; i < num_streams; i++) {
+		struct xsk_opts child_opt = ctx->opt;
+
+		/* Inhibit XDP prog load — parent already has it or doesn't need one */
+		child_opt.shared_umem = true;
+
+		ctx->stream_xsks[i] = xsk_configure_socket(&child_opt, ctx->umem,
+							    false, true);
+		if (IS_ERR(ctx->stream_xsks[i])) {
+			ret = PTR_ERR(ctx->stream_xsks[i]);
+			pr_warn("Failed to create stream socket %d: %s\n",
+				i, strerror(-ret));
+			goto err_sockets;
+		}
+		ctx->num_stream_xsks++;
+	}
+
+	/* Fork one child per stream */
+	for (i = 0; i < num_streams; i++) {
+		/* Allocate stream context in shared memory */
+		stream = mmap(NULL, sizeof(struct etf_stream_ctx),
+			      PROT_READ | PROT_WRITE,
+			      MAP_SHARED | MAP_ANONYMOUS, -1, 0);
+		if (stream == MAP_FAILED) {
+			ret = -errno;
+			goto err_streams;
+		}
+		memset(stream, 0, sizeof(*stream));
+
+		stream->index = cfgs[i].index;
+		stream->tx_cycle_ns = TIME_US_TO_NS(cfgs[i].cycle_us);
+		stream->tx_offset_time_ns = TIME_US_TO_NS(cfgs[i].offset_us);
+		stream->tx_preload_time_ns = TIME_US_TO_NS(cfgs[i].preload_us);
+		stream->frame_start = i * frames_per_stream;
+		stream->frame_count = frames_per_stream;
+
+		stream->tx_cycle_diff_min = 1000000000;
+		stream->tx_cycle_diff_max = 0;
+		stream->tx_cycle_diff_ave = 0.0;
+
+		/* Pre-populate free ring with this stream's frame range */
+		for (__u32 j = 0; j < frames_per_stream; j++) {
+			stream->free_ring[j] =
+				(stream->frame_start + j) * ctx->opt.frame_size;
+		}
+		atomic_store_explicit(&stream->free_ring_head, frames_per_stream,
+				      memory_order_release);
+		atomic_store_explicit(&stream->free_ring_tail, 0,
+				      memory_order_release);
+
+		ctx->streams[ctx->stream_idx++] = stream;
+
+		pid = fork();
+		if (pid < 0) {
+			ret = -errno;
+			pr_warn("fork() failed: %s\n", strerror(errno));
+			goto err_streams;
+		}
+
+		if (pid == 0) {
+			/* --- Child process --- */
+			struct sigaction sa;
+
+			/* Install signal handler for clean shutdown */
+			memset(&sa, 0, sizeof(sa));
+			sa.sa_handler = child_signal_handler;
+			sigaction(SIGTERM, &sa, NULL);
+			sigaction(SIGINT, &sa, NULL);
+
+			/* Unblock signals that parent blocked for signalfd */
+			sigset_t unblock;
+			sigemptyset(&unblock);
+			sigaddset(&unblock, SIGTERM);
+			sigaddset(&unblock, SIGINT);
+			sigaddset(&unblock, SIGQUIT);
+			sigprocmask(SIG_UNBLOCK, &unblock, NULL);
+
+			/* Lock all pages in child process */
+			mlockall(MCL_CURRENT | MCL_FUTURE);
+
+			/* Set scheduler priority */
+			xsk_set_sched_priority(ctx->opt.sched_policy,
+					       ctx->opt.sched_prio);
+
+			/*
+			 * Use the pre-created socket for this stream.
+			 * The child inherits the fd from fork().
+			 * Point ctx->xsks[0] to this stream's socket.
+			 */
+			ctx->xsks[0] = ctx->stream_xsks[i];
+			ctx->num_socks = 1;
+
+			/* Run TX loop */
+			xsk_tx_only_child(stream, ctx);
+
+			/*
+			 * Cleanup: close our copy of the socket fd
+			 * explicitly, then _exit().  Do NOT call
+			 * xsk_socket__delete() — it tries to detach
+			 * XDP programs and manipulate libxdp refcounts,
+			 * which would corrupt parent state.
+			 *
+			 * Close the socket fd for this stream's socket
+			 * so the kernel releases resources promptly.
+			 * _exit() closes remaining inherited fds
+			 * (anchor socket, other stream sockets, signalfd).
+			 */
+			close(xsk_socket__fd(ctx->stream_xsks[i]->xsk));
+			_exit(0);
+		}
+
+		/* --- Parent process --- */
+		stream->pid = pid;
+		pr_info("Process %d (stream %ld): cycle = %u us, "
+			"offset = %u us, preload = %u us\n",
+			pid, cfgs[i].index, cfgs[i].cycle_us,
+			cfgs[i].offset_us, cfgs[i].preload_us);
+	}
+
+	return 0;
+
+err_streams:
+	for (i = 0; i < ctx->stream_idx; i++) {
+		stream = ctx->streams[i];
+		if (stream && stream->pid > 0) {
+			kill(stream->pid, SIGTERM);
+			waitpid(stream->pid, NULL, 0);
+		}
+		if (stream) {
+			munmap(stream, sizeof(struct etf_stream_ctx));
+			ctx->streams[i] = NULL;
+		}
+	}
+	ctx->stream_idx = 0;
+err_sockets:
+	/* Clean up any stream sockets we created */
+	for (int j = 0; j < ctx->num_stream_xsks; j++) {
+		if (!IS_ERR(ctx->stream_xsks[j])) {
+			xsk_socket__delete(ctx->stream_xsks[j]->xsk);
+			free(ctx->stream_xsks[j]);
+			ctx->stream_xsks[j] = NULL;
+		}
+	}
+	ctx->num_stream_xsks = 0;
+	return ret;
+}
+
+int xsk_wait_streams(struct xsk_ctx *ctx)
+{
+	int i;
+
+	for (i = 0; i < ctx->stream_idx; i++) {
+		if (ctx->streams[i] && ctx->streams[i]->pid > 0)
+			waitpid(ctx->streams[i]->pid, NULL, 0);
+	}
+	return 0;
+}
