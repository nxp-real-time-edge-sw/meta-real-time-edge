+/*
+ * Free ring helpers for shared-UMEM mode.
+ * Parent is the sole producer (pushes reclaimed frames from CQ).
+ * Each child is the sole consumer of its own stream's ring.
+ * No locking needed: single-producer / single-consumer.
+ */
+static inline int etf_stream_free_push(struct etf_stream_ctx *s, __u64 addr)
+{
+	unsigned int head = atomic_load_explicit(&s->free_ring_head,
+						 memory_order_relaxed);
+	unsigned int tail = atomic_load_explicit(&s->free_ring_tail,
+						 memory_order_acquire);
+
+	if (head - tail >= STREAM_FREE_RING_SIZE)
+		return -ENOSPC;
+
+	s->free_ring[head % STREAM_FREE_RING_SIZE] = addr;
+	atomic_store_explicit(&s->free_ring_head, head + 1,
+			      memory_order_release);
+	return 0;
+}
+
+static inline int etf_stream_free_pop(struct etf_stream_ctx *s, __u64 *addr)
+{
+	unsigned int tail = atomic_load_explicit(&s->free_ring_tail,
+						 memory_order_relaxed);
+	unsigned int head = atomic_load_explicit(&s->free_ring_head,
+						 memory_order_acquire);
+
+	/* Use subtraction to handle unsigned wraparound correctly */
+	if (head - tail == 0)
+		return -EAGAIN;
+
+	*addr = s->free_ring[tail % STREAM_FREE_RING_SIZE];
+	atomic_store_explicit(&s->free_ring_tail, tail + 1,
+			      memory_order_release);
+	return 0;
+}
+
+/*
+ * Parent-only: drain the shared completion ring and push reclaimed
+ * frames back to the owning stream's per-stream free ring.
+ * Frame ownership is determined by address range (static partitioning).
+ *
+ * Thread safety: this function is only called from the parent's
+ * single-threaded xsk_stats_poller() loop.  Children never touch
+ * the CQ — they only produce to their own TX rings and consume
+ * from their per-stream SPSC free rings.  The CQ is single-consumer
+ * by AF_XDP design, and the parent is the sole consumer.
+ */
+static void drain_shared_cq(struct xsk_ctx *ctx)
+{
+	struct xsk_umem_info *umem = ctx->umem;
+	__u32 frames_per_stream;
+	unsigned int rcvd;
+	__u32 idx = 0;
+	unsigned int i;
+
+	if (!umem || !umem->umem || ctx->stream_idx <= 0)
+		return;
+
+	frames_per_stream = NUM_FRAMES / ctx->stream_idx;
+
+	rcvd = xsk_ring_cons__peek(&umem->cq, 64, &idx);
+	if (!rcvd)
+		return;
+
+	for (i = 0; i < rcvd; i++) {
+		__u64 addr = *xsk_ring_cons__comp_addr(&umem->cq, idx + i);
+		__u32 frame_idx;
+		int sid;
+
+		/* Undo TX metadata offset to get the real frame base */
+		addr -= TX_METADATA_SIZE;
+
+		/* Determine owning stream by frame index range */
+		frame_idx = addr / ctx->opt.frame_size;
+		sid = frame_idx / frames_per_stream;
+
+		if (etf_stream_free_push(ctx->streams[sid], addr))
+			pr_warn("CQ drain: stream %d free ring full, frame 0x%llx lost\n",
+				sid, (unsigned long long)addr);
+	}
+
+	xsk_ring_cons__release(&umem->cq, rcvd);
+}
